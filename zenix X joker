RunService.Heartbeat:Connect(function(dt)
	local function step(cols, limit)
		for _, item in ipairs(cols) do
			local newY = item.label.Position.Y.Offset + item.speed * dt
			if newY > limit then
				newY = item.resetY
				item.label.Text = item.gen()
			end
			item.label.Position = UDim2.new(item.label.Position.X.Scale, item.label.Position.X.Offset, 0, newY)
			item.updateTimer = item.updateTimer + 1
			if item.updateTimer >= item.updateRate then
				item.updateTimer = 0
				item.label.Text = item.gen()
			end
		end
	end
	if Frame.Visible then step(matrixColumns, 360) end
	if ConfirmFrame.Visible then step(confirmMatrixCols, 150) end
	if CloseConfirmFrame.Visible then step(closeMatrixCols, 150) end
	if Question1Frame.Visible then step(q1MatrixCols, 160) end
	if Question2Frame.Visible then step(q2MatrixCols, 170) end
end)

