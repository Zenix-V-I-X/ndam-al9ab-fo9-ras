local function updateRow(userId)
	local rowData = Rows[userId]
	local stat = Stats[userId]
	if not rowData or not stat then return end

	if userId == LocalPlayer.UserId then
		rowData.statsLabel.Text = string.format("Time: %s", formatTime(stat.Time))
	else
		rowData.statsLabel.Text = string.format("In: %d   Out: %d   Time: %s", stat.JoinCount, stat.LeaveCount, formatTime(stat.Time))
	end

	if stat.Online then
		rowData.stroke.Transparency = 0.4
		rowData.nameLabel.TextTransparency = 0
		rowData.statsLabel.TextTransparency = 0
		rowData.statusLabel.TextTransparency = 0
		rowData.avatar.ImageTransparency = 0
	else
		rowData.stroke.Transparency = 0.8
		rowData.nameLabel.TextTransparency = 0.4
		rowData.statsLabel.TextTransparency = 0.4
		rowData.statusLabel.TextTransparency = 0.4
		rowData.avatar.ImageTransparency = 0.4
	end
end

local function addPlayer(player)
	if Stats[player.UserId] then return end
	Stats[player.UserId] = {
		JoinCount = 0,
		LeaveCount = 0,
		Time = 0,
		Online = player.Parent == Players,
		Name = player.Name,
		DisplayName = player.DisplayName,
	}
	createRow(player)
	updateRow(player.UserId)
	updateFooter()
end

local function findPlayer(query)
	query = query:lower()
	if query == "" then return nil end
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Name:lower() == query or pl.DisplayName:lower() == query then
			return pl
		end
	end
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Name:lower():find(query, 1, true) or pl.DisplayName:lower():find(query, 1, true) then
			return pl
		end
	end
	return nil
end

Input.FocusLost:Connect(function()
	local pl = findPlayer(Input.Text)
	if pl then
		addPlayer(pl)
		Input.Text = ""
	end
end)

Players.PlayerAdded:Connect(function(pl)
	local stat = Stats[pl.UserId]
	if stat then
		stat.JoinCount = stat.JoinCount + 1
		stat.Online = true
		updateRow(pl.UserId)
		updateFooter()
	end
end)

Players.PlayerRemoving:Connect(function(pl)
	local stat = Stats[pl.UserId]
	if stat then
		stat.LeaveCount = stat.LeaveCount + 1
		stat.Online = false
		updateRow(pl.UserId)
		updateFooter()
	end
end)

local acc = 0
RunService.Heartbeat:Connect(function(dt)
	for _, stat in pairs(Stats) do
		if stat.Online then
			stat.Time = stat.Time + dt
		end
	end
	acc = acc + dt
	if acc >= 0.25 then
		acc = 0
		for userId, stat in pairs(Stats) do
			if stat.Online then
				updateRow(userId)
			end
		end
	end
end)

