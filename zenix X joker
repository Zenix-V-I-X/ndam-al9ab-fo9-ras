local function collectTargets()
	local list = {
		{ obj = Frame, prop = "BackgroundTransparency", open = 0 },
		{ obj = FrameStroke, prop = "Transparency", open = 0.2 },
		{ obj = Title, prop = "TextTransparency", open = 0 },
		{ obj = TabBar, prop = "BackgroundTransparency", open = 0 },
		{ obj = Tab1, prop = "TextTransparency", open = 0 },
		{ obj = Tab2, prop = "TextTransparency", open = 0 },
		{ obj = Input, prop = "BackgroundTransparency", open = 0 },
		{ obj = Input, prop = "TextTransparency", open = 0 },
		{ obj = Scroll, prop = "ScrollBarImageTransparency", open = 0 },
		{ obj = AntisScroll, prop = "ScrollBarImageTransparency", open = 0 },
		{ obj = Footer, prop = "TextTransparency", open = 0 },
	}

	for _, item in ipairs(matrixColumns) do
		table.insert(list, { obj = item.label, prop = "TextTransparency", open = 0.65 })
	end

	for _, td in ipairs(ToggleDefs) do
		if td.btn then
			table.insert(list, { obj = td.btn, prop = "BackgroundTransparency", open = 0 })
			table.insert(list, { obj = td.stroke, prop = "Transparency", open = td.on and 0.2 or 0.5 })
			table.insert(list, { obj = td.nameLbl, prop = "TextTransparency", open = 0 })
			table.insert(list, { obj = td.statusLbl, prop = "TextTransparency", open = 0 })
		end
	end

	for _, rd in pairs(Rows) do
		table.insert(list, { obj = rd.row, prop = "BackgroundTransparency", open = 0 })
		table.insert(list, { obj = rd.avatar, prop = "ImageTransparency", open = 0 })
		table.insert(list, { obj = rd.avatar, prop = "BackgroundTransparency", open = 0 })
		table.insert(list, { obj = rd.nameLabel, prop = "TextTransparency", open = 0 })
		table.insert(list, { obj = rd.statsLabel, prop = "TextTransparency", open = 0 })
		table.insert(list, { obj = rd.statusLabel, prop = "TextTransparency", open = 0 })
		if rd.btnCopy then
			table.insert(list, { obj = rd.btnCopy, prop = "TextTransparency", open = 0 })
		end
		if rd.btnDelete then
			table.insert(list, { obj = rd.btnDelete, prop = "TextTransparency", open = 0 })
		end
	end
	return list
end

local animating = false

local function toggleFrame()
	if animating then return end
	animating = true

	local info = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	if not Frame.Visible then
		Frame.Visible = true
		for _, t in ipairs(collectTargets()) do
			TweenService:Create(t.obj, info, { [t.prop] = t.open }):Play()
		end
		task.wait(0.25)
		animating = false
	else
		for _, t in ipairs(collectTargets()) do
			TweenService:Create(t.obj, info, { [t.prop] = 1 }):Play()
		end
		task.wait(0.25)
		Frame.Visible = false
		animating = false
	end
end

