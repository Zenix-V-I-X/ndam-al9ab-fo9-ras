local dragging, dragInput, dragStart, startPos
Button.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = Button.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)
Button.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if dragging and input == dragInput then
		local delta = input.Position - dragStart
		Button.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

local function createMatrixRain(parent, numCols, colorSet)
	colorSet = colorSet or { WHITE, WHITE_DIM, GRAY }
	local container = Instance.new("Frame")
	container.Name = "HackerBackground"
	container.Size = UDim2.new(1, 0, 1, 0)
	container.BackgroundColor3 = BLACK
	container.BackgroundTransparency = 1
	container.ZIndex = parent.ZIndex
	container.ClipsDescendants = true
	container.Parent = parent

	local cols = {}
	local function gen()
		local s = ""
		for _ = 1, 14 do
			s = s .. (math.random(0, 1) == 1 and "1\n" or "0\n")
		end
		return s
	end

	for i = 1, numCols do
		local col = Instance.new("TextLabel")
		col.Size = UDim2.new(0, 18, 1, 100)
		col.Position = UDim2.new((i - 1) / numCols, 2, 0, math.random(-180, -20))
		col.BackgroundTransparency = 1
		col.TextColor3 = colorSet[((i - 1) % #colorSet) + 1]
		col.TextTransparency = math.random(45, 80) / 100
		col.Font = Enum.Font.Code
		col.TextSize = 11
		col.TextWrapped = true
		col.TextYAlignment = Enum.TextYAlignment.Top
		col.ZIndex = parent.ZIndex
		col.TextStrokeTransparency = 0.85
		col.TextStrokeColor3 = colorSet[1]
		col.Parent = container
		col.Text = gen()

		table.insert(cols, {
			label = col,
			speed = math.random(40, 90),
			resetY = math.random(-150, -50),
			updateTimer = 0,
			updateRate = math.random(4, 10),
			gen = gen,
		})
	end
	return cols
end

