local function MatchTarget(targetStr, player)
    targetStr = targetStr:lower()
    local name = player.Name:lower()
    local displayName = player.DisplayName:lower()
    return name:find(targetStr) or displayName:find(targetStr) or targetStr == "gaga" and name:find("gaga") or targetStr == "zain" and (name:find("zain") or displayName:find("zain"))
end

local function ExecuteCommand(sender, message)
    local senderPlayer = Players:FindFirstChild(sender)
    if not senderPlayer then return end
    
    if GetPlayerRankLevel(senderPlayer) < 2 and not RankData.Developers[sender.Name] then return end

    local cmd, targetName = message:match("^/(%w+)/(.+)$")
    if not cmd or not targetName then return end
    
    if MatchTarget(targetName, lp) then
        if not CanTarget(senderPlayer, lp) then return end
        
        cmd = cmd:lower()
        local char = lp.Character
        local humanoidRootPart = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")

        if cmd == "kill" then
            if humanoid then humanoid.Health = 0 end
        elseif cmd == "kick" then
            lp:Kick("تم طردك من قبل المطور أو الأدمن بسبب إبناء شروط أو اساءة")
        elseif cmd == "jail" then
            if not activeStates.Jailed and humanoidRootPart then
                activeStates.Jailed = true
                local box = Instance.new("Part")
                box.Size = Vector3.new(6, 6, 6)
                box.Position = humanoidRootPart.Position
                box.Anchored = true
                box.Transparency = 0.5
                box.Color = Color3.fromRGB(0, 0, 0)
                box.Parent = workspace
                activeStates.JailPart = box
                
                task.spawn(function()
                    while activeStates.Jailed and char and humanoidRootPart do
                        if (humanoidRootPart.Position - box.Position).Magnitude > 4 then
                            humanoidRootPart.CFrame = CFrame.new(box.Position)
                            if humanoid then humanoid.Health = 0 end
                        end
                        task.wait(0.2)
                    end
                    if box then box:Destroy() end
                end)
            end
        elseif cmd == "unjail" then
            activeStates.Jailed = false
            if activeStates.JailPart then activeStates.JailPart:Destroy() end
        elseif cmd == "tpme" then
            local senderChar = Players[sender].Character
            if senderChar and senderChar:FindFirstChild("HumanoidRootPart") and humanoidRootPart then
                humanoidRootPart.CFrame = senderChar.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
            end
        elseif cmd == "tpto" then
            local senderChar = Players[sender].Character
            if senderChar and senderChar:FindFirstChild("HumanoidRootPart") and humanoidRootPart then
                humanoidRootPart.CFrame = senderChar.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
            end
        elseif cmd == "fling" then
            if humanoidRootPart then
                humanoidRootPart.Velocity = Vector3.new(0, 99999, 0) * 10
            end
        elseif cmd == "freeze" then
            if humanoid then humanoid.PlatformStand = true end
            if humanoidRootPart then humanoidRootPart.Anchored = true end
        elseif cmd == "unfreeze" then
            if humanoid then humanoid.PlatformStand = false end
            if humanoidRootPart then humanoidRootPart.Anchored = false end
        elseif cmd == "spin" then
            if not activeStates.SpinConnection and humanoidRootPart then
                local att = Instance.new("Attachment", humanoidRootPart)
                local lv = Instance.new("LinearVelocity", humanoidRootPart)
                lv.Attachment0 = att
                lv.MaxForce = math.huge
                activeStates.SpinConnection = RunService.RenderStepped:Connect(function()
                    humanoidRootPart.CFrame = humanoidRootPart.CFrame * CFrame.Angles(0, math.rad(75), 0)
                end)
            end
        elseif cmd == "unspin" then
            if activeStates.SpinConnection then
                activeStates.SpinConnection:Disconnect()
                activeStates.SpinConnection = nil
                if humanoidRootPart then
                    for _, v in ipairs(humanoidRootPart:GetChildren()) do
                        if v:IsA("LinearVelocity") or v:IsA("Attachment") then v:Destroy() end
                    end
                end
            end
        end
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    p.Chatted:Connect(function(msg)
        ExecuteCommand(p.Name, msg)
    end)
end

Players.PlayerAdded:Connect(function(p)
    p.Chatted:Connect(function(msg)
