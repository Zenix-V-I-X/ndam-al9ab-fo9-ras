local function GetPlayerRankLevel(player)
    if RankData.Developers[player.Name] then return 3 end
    if RankData.Admins[player.Name] or RankData.Special[player.Name] then return 2 end
    return 1
end

local function CanTarget(actor, target)
    local actorLevel = GetPlayerRankLevel(actor)
    local targetLevel = GetPlayerRankLevel(target)
    if actor == target then return true end
    if actorLevel == 3 then return true end
    if actorLevel == 2 and targetLevel < 3 and targetLevel ~= 2 then return true end
    return false
end

local function CheckEligibility(Player)
    local Name = Player.Name
    if RankData.Developers[Name] then
        RecognizedPlayers[Player] = {Title = "المطور زينكس"}
    elseif RankData.Admins[Name] then
        RecognizedPlayers[Player] = {Title = "ادمن"}
    elseif RankData.Special[Name] then
        RecognizedPlayers[Player] = {Title = SpecialTitles[Name] or "صملاوي جلاد"}
    elseif RankData.Assistants[Name] then
        RecognizedPlayers[Player] = {Title = "مساعد"}
    elseif RankData.ImportantMembers[Name] then
        RecognizedPlayers[Player] = {Title = "عضو مهم"}
    end
end

local function ApplyRank(Player)
    local Data = RecognizedPlayers[Player]
    if not Data then return end

    local Character = Player.Character
    if not Character then return end

    local Head = Character:WaitForChild("Head", 5)
    if not Head then return end

    local existingTag = Character:FindFirstChild("RoyalTag")
    if existingTag then
        existingTag:Destroy()
    end

    local Billboard = Instance.new("BillboardGui")
    Billboard.Name = "RoyalTag"
    Billboard.Adornee = Head
    Billboard.Parent = Character
    Billboard.Size = UDim2.new(6, 0, 2.5, 0)
    Billboard.StudsOffset = Vector3.new(0, 4, 0)
    Billboard.AlwaysOnTop = true
    Billboard.MaxDistance = 300

    local Frame = Instance.new("Frame", Billboard)
    Frame.Size = UDim2.new(1, 0, 1, 0)
    Frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    Frame.BackgroundTransparency = 0.5
    Frame.BorderSizePixel = 0
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 16)

    local Stroke = Instance.new("UIStroke", Frame)
    Stroke.Thickness = 3
    Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    local Gradient = Instance.new("UIGradient", Frame)
    Gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.25, Color3.fromRGB(0, 0, 0)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.75, Color3.fromRGB(0, 0, 0)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255))
    })

    task.spawn(function()
        while Frame and Frame.Parent do
            Gradient.Rotation = Gradient.Rotation + 25
            task.wait(0.02)
        end
    end)

    local TitleLabel = Instance.new("TextLabel", Frame)
    TitleLabel.Size = UDim2.new(0.9, 0, 0.45, 0)
    TitleLabel.Position = UDim2.new(0.05, 0, 0.1, 0)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = "♧ " .. Data.Title .. " ♧"
    TitleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    TitleLabel.FontFace = ArabicFont
    TitleLabel.TextScaled = true

    local SubLabel = Instance.new("TextLabel", Frame)
    SubLabel.Size = UDim2.new(0.9, 0, 0.3, 0)
    SubLabel.Position = UDim2.new(0.05, 0, 0.55, 0)
    SubLabel.BackgroundTransparency = 1
    SubLabel.Text = TagSubTitle
    SubLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    SubLabel.FontFace = EnglishFont
    SubLabel.TextScaled = true
end

local function SetupPlayer(Player)
    CheckEligibility(Player)

    if RecognizedPlayers[Player] then
        Player.CharacterAdded:Connect(function(Character)
            Character:WaitForChild("Head", 10)
            task.wait(0.3)
            ApplyRank(Player)
            
            local humanoid = Character:WaitForChild("Humanoid", 10)
            if humanoid then
                humanoid.Died:Connect(function()
                    task.wait(2)
                    if Player.Character == Character then
                        ApplyRank(Player)
                    end
                end)
            end
        end)

        if Player.Character then
            task.spawn(function()
                Player.Character:WaitForChild("Head", 10)
                ApplyRank(Player)
                local humanoid = Player.Character:WaitForChild("Humanoid", 10)
                if humanoid then
                    humanoid.Died:Connect(function()
                        task.wait(2)
                        if Player.Character then
                            ApplyRank(Player)
                        end
                    end)
                end
            end)
        end
    end
end

task.spawn(function()
    while true do
        task.wait(1)
