local playMode = "scooter"
local currentMusicID = ""

local function playScooterRegular(id)
    pcall(function()
        local remote = ReplicatedStorage:WaitForChild("RE", 2):FindFirstChild("1NoMoto1rVehicle1s")
        if remote then
            remote:FireServer("Segway")
            task.wait(0.3)
            remote:FireServer("PickingScooterMusicText", tostring(id))
        end
    end)
end

local function playScooterPremium(id)
    pcall(function()
        local remote = ReplicatedStorage:WaitForChild("RE", 2):FindFirstChild("1NoMoto1rVehicle1s")
        if remote then
            remote:FireServer("SegwaySmall")
            task.wait(0.3)
            remote:FireServer("PickingScooterMusicText", tostring(id))
        end
    end)
end

local function playHouse(id)
    pcall(function()
        local RE = ReplicatedStorage:FindFirstChild("RE")
        if RE then
            local houseRemote = RE:FindFirstChild("1Player1sHous1e")
            if houseRemote then
                houseRemote:FireServer("PickHouseMusicText", tostring(id), nil, true)
            end
        end
    end)
end

local function playBoombox(id)
    pcall(function()
        local RE = ReplicatedStorage:FindFirstChild("RE")
        if RE then
            local toolRemote = RE:FindFirstChild("PlayerToolEvent")
            if toolRemote then
                toolRemote:FireServer("ToolMusicText", tostring(id), nil, true)
            end
        end
    end)
end

local function playMusicEverywhere(id)
    playScooterPremium(id)
    playHouse(id)
    playBoombox(id)
end

local function playMusic(id)
    if not id or id == "" then return end
    if playMode == "scooter" then
        playScooterRegular(id)
    elseif playMode == "premium" then
        playScooterPremium(id)
    elseif playMode == "house" then
        playHouse(id)
    elseif playMode == "boombox" then
        playBoombox(id)
    elseif playMode == "everywhere" then
        playMusicEverywhere(id)
    end
end

local function removeScooter()
    pcall(function()
        local remote = ReplicatedStorage:WaitForChild("RE", 2):FindFirstChild("1NoMoto1rVehicle1s")
        if remote then
            remote:FireServer("Delete NoMotorVehicle")
        end
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Running)
        end
    end)
end

local rainbowScooterEnabled = false
local function toggleRainbowScooter(v)
    rainbowScooterEnabled = v
    if v then
        task.spawn(function()
            while rainbowScooterEnabled do
                local hue = tick() % 5 / 5
                local color = Color3.fromHSV(hue, 1, 1)
                pcall(function()
                    local RE = ReplicatedStorage:WaitForChild("RE")
                    if RE then
                        local carRemote = RE:WaitForChild("1Player1sCa1r")
                        if carRemote then
                            carRemote:FireServer("NoMotorColor", color)
                        end
                    end
                    local Remotes = ReplicatedStorage:WaitForChild("Remotes")
                    if Remotes then
                        local underglow = Remotes:WaitForChild("SetUnderglowColor")
                        if underglow then
                            underglow:InvokeServer(1, color)
                        end
                    end
                end)
                task.wait(0.1)
            end
        end)
    end
end

local function takeBoombox()
    pcall(function()
        local remote = ReplicatedStorage:FindFirstChild("RE")
        if remote then
            local toolRemote = remote:FindFirstChild("1Too1l")
            if toolRemote then
                toolRemote:InvokeServer("PickingTools", "Boombox")
            end
        end
    end)
end

