local function StopBangFor(player)
    if not player then return end
    local pName = player.Name
    if BangState[pName] then
        BangState[pName].Active = false
        if BangState[pName].Connection then
            BangState[pName].Connection:Disconnect()
            BangState[pName].Connection = nil
        end
        local char = player.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hrp then
                local rayOrigin = hrp.Position + Vector3.new(0, 5, 0)
                local rayDir = Vector3.new(0, -500, 0)
                local rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                rayParams.FilterDescendantsInstances = {char}
                local result = workspace:Raycast(rayOrigin, rayDir, rayParams)
                local groundY = result and (result.Position.Y + 3) or hrp.Position.Y
                hrp.CFrame = CFrame.new(hrp.Position.X, groundY, hrp.Position.Z)
                hrp.Velocity = Vector3.zero
                hrp.RotVelocity = Vector3.zero
            end
            if hum then hum.PlatformStand = false; hum.AutoRotate = true end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = true end
            end
        end
        BangState[pName] = nil
    end
end

local function StartBang(player, targetPlayer, mode)
    if not player or not targetPlayer then return end
    if player == targetPlayer then return end
    local pName = player.Name
    if BangState[pName] and BangState[pName].Active and BangState[pName].Mode == mode then
        StopBangFor(player); return
    end
    if BangState[pName] and BangState[pName].Active then StopBangFor(player) end
    if not targetPlayer.Character then return end
    local tHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not tHRP then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    BangState[pName] = { Active = true, Mode = mode, Target = targetPlayer, Connection = nil }
    hum.PlatformStand = true
    hum.AutoRotate = false
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end
    BangState[pName].Connection = RunService.Heartbeat:Connect(function()
        local state = BangState[pName]
        if not state or not state.Active then return end
        if not hrp or not hrp.Parent then return end
        local target = state.Target
        if not target or not target.Character then return end
        local tc = target.Character
        local thrp = tc:FindFirstChild("HumanoidRootPart")
        local th = tc:FindFirstChild("Head")
        if not thrp then return end
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
        local w = math.sin(tick() * 55)
        local dr = w * 4.5
        local nr = w * 2.5
        local currentMode = state.Mode
        if currentMode == "combined" then
            if math.floor(tick() * 60) % 2 == 0 then
                if th then hrp.CFrame = th.CFrame * CFrame.new(0, -0.6, dr) * CFrame.Angles(0, math.rad(180), 0) end
            else
                hrp.CFrame = thrp.CFrame * CFrame.new(0, 0.5, dr + 1.5)
            end
        elseif currentMode == "face" then
            if th then hrp.CFrame = th.CFrame * CFrame.new(0, -0.6, dr) * CFrame.Angles(0, math.rad(180), 0) end
        elseif currentMode == "back" then
            hrp.CFrame = thrp.CFrame * CFrame.new(0, 0.5, nr + 1.2)
        elseif currentMode == "v2body" then
            local pts = {}
            for _, p in ipairs(tc:GetChildren()) do
                if p:IsA("BasePart") then table.insert(pts, p) end
            end
            if #pts > 0 then
                hrp.CFrame = pts[math.random(1, #pts)].CFrame * CFrame.new(math.random(-1, 1), math.random(-1, 1), math.random(-1, 1)) * CFrame.Angles(math.rad(math.random(360)), math.rad(math.random(360)), math.rad(math.random(360)))
            end
        elseif currentMode == "v2face" then
            if th then hrp.CFrame = th.CFrame * CFrame.Angles(math.rad(math.random(360)), math.rad(math.random(360)), math.rad(math.random(360))) end
        end
    end)
end

