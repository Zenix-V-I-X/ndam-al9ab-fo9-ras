    -- دالة تحديث قائمة اللاعبين المتصلين
    local function UpdateConnectedPlayers()
        local ok, data = HttpCall("GET", "ConnectedPlayers.json")
        if not ok or type(data) ~= "table" then return end
        
        local currentTime = os.time()
        -- حذف الكروت القديمة باستثناء التخطيط
        for _, v in ipairs(ConnectedScroll:GetChildren()) do
            if v:IsA("Frame") and v.Name:match("^Card_") then
                v:Destroy()
            end
        end
        
        for pName, pData in pairs(data) do
            -- عرض اللاعبين المتصلين في اخر 60 ثانية فقط
            if pData.LastSeen and (currentTime - pData.LastSeen) <= 60 then
                CreatePlayerCard(pData)
            end
        end
    end

    -- تحديث القائمة كل 10 ثواني طالما القائمة مفتوحة
    task.spawn(function()
        while true do
            if ConnectedTab.Visible then
                pcall(UpdateConnectedPlayers)
            end
            task.wait(10)
        end
    end)


