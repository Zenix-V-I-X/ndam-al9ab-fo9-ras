            addDecal(p, "STATUEDECAL")
            addParticles(p, 14, 130, 22)
            addRealFire(p, 25, 30)
            return p
        end

        local statues = {}
        local usedPositions = {}

        local function farEnough(pos, minDist)
            minDist = minDist or 80
            for _, u in ipairs(usedPositions) do
                if (u - pos).Magnitude < minDist then return false end
            end
            return true
        end

        local function createStatueAt(pos)
            local folder = Instance.new("Folder")
            folder.Name = "RedStatue_" .. (#statues + 1)
            folder.Parent = statueFolder

            local groundY = getGroundY(pos.X, pos.Z)
            local rootPart = Instance.new("Part")
            rootPart.Name = "HumanoidRootPart"
            rootPart.Size = Vector3.new(2*SCALE, 2*SCALE, 1*SCALE)
            rootPart.Anchored = true
            rootPart.CanCollide = false
            rootPart.Transparency = 1
            rootPart.CFrame = CFrame.new(pos.X, groundY + 4*SCALE, pos.Z)
            rootPart.Parent = folder

            local torso = makePart("Torso", Vector3.new(2*SCALE, 2*SCALE, 1*SCALE), false)
            local head  = makePart("Head",  Vector3.new(1.6*SCALE, 1.6*SCALE, 1.6*SCALE), true)
            local larm  = makePart("LArm",  Vector3.new(1*SCALE, 2.2*SCALE, 1*SCALE), false)
            local rarm  = makePart("RArm",  Vector3.new(1*SCALE, 2.2*SCALE, 1*SCALE), false)
            local lleg  = makePart("LLeg",  Vector3.new(1.1*SCALE, 2.2*SCALE, 1.1*SCALE), false)
            local rleg  = makePart("RLeg",  Vector3.new(1.1*SCALE, 2.2*SCALE, 1.1*SCALE), false)
            torso.Parent = folder
            head.Parent = folder
            larm.Parent = folder
            rarm.Parent = folder
            lleg.Parent = folder
            rleg.Parent = folder

            local function motor(name, p0, p1, c0, c1)
                local m = Instance.new("Motor6D")
                m.Name = name
                m.Part0 = p0
                m.Part1 = p1
                m.C0 = c0
                m.C1 = c1
                m.Parent = p0
                return m
            end
            motor("RootJoint", rootPart, torso, CFrame.new(), CFrame.new())
            motor("Neck", torso, head, CFrame.new(0, 1.3*SCALE, 0), CFrame.new(0, -0.8*SCALE, 0))
            local ls = motor("LeftShoulder", torso, larm, CFrame.new(-1.5*SCALE, 0.6*SCALE, 0), CFrame.new(0, 1.1*SCALE, 0))
            local rs = motor("RightShoulder", torso, rarm, CFrame.new(1.5*SCALE, 0.6*SCALE, 0), CFrame.new(0, 1.1*SCALE, 0))
            local lh = motor("LeftHip", torso, lleg, CFrame.new(-0.6*SCALE, -1*SCALE, 0), CFrame.new(0, 1.1*SCALE, 0))
            local rh = motor("RightHip", torso, rleg, CFrame.new(0.6*SCALE, -1*SCALE, 0), CFrame.new(0, 1.1*SCALE, 0))

            table.insert(statues, {
                folder = folder, root = rootPart,
                ls = ls, rs = rs, lh = lh, rh = rh,
                origLs = ls.C0, origRs = rs.C0, origLh = lh.C0, origRh = rh.C0,
                position = Vector3.new(pos.X, groundY + 4*SCALE, pos.Z),
                target = Vector3.new(pos.X, groundY + 4*SCALE, pos.Z),
                yaw = 0, walkPhase = 0, lastPick = 0,
                speed = math.random(50, 100) / 10,
            })
