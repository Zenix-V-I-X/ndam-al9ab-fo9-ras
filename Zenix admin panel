    local isResizing = false
    Resizer.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isResizing = true
            MainFrame.Draggable = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isResizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local framePos = MainFrame.AbsolutePosition
            local newSize = UDim2.new(0, math.max(350, input.Position.X - framePos.X), 0, math.max(250, input.Position.Y - framePos.Y))
            MainFrame.Size = newSize
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isResizing = false
            MainFrame.Draggable = true
        end
    end)

    local uiVisible = true
    local isMin = false
    local isTweening = false
    local originalMainSize = MainFrame.Size
    local originalBtnSize = ToggleBtn.Size

    ToggleBtn.MouseButton1Click:Connect(function()
        if isTweening then return end
        isTweening = true
        uiVisible = not uiVisible

        ToggleBtn:TweenSize(UDim2.new(0, originalBtnSize.X.Offset - 10, 0, originalBtnSize.Y.Offset - 10), "Out", "Quad", 0.1, true, function()
            ToggleBtn:TweenSize(originalBtnSize, "Out", "Back", 0.2, true)
        end)

        if uiVisible then
            MainFrame.Visible = true
            local targetSize = isMin and UDim2.new(0, originalMainSize.X.Offset, 0, 40) or originalMainSize
            local targetPos = UDim2.new(0.5, -originalMainSize.X.Offset/2, 0.5, -originalMainSize.Y.Offset/2)
            MainFrame:TweenSizeAndPosition(targetSize, targetPos, "Out", "Back", 0.5, true, function()
                isTweening = false
            end)
        else
            MainFrame:TweenSizeAndPosition(UDim2.new(0, 0, 0, 0), UDim2.new(0.5, 0, 0.5, 0), "In", "Back", 0.4, true, function()
                MainFrame.Visible = false
                isTweening = false
            end)
        end
    end)

    MinimizeBtn.MouseButton1Click:Connect(function()
        if isTweening then return end
        isTweening = true
        isMin = not isMin

        if isMin then
            originalMainSize = MainFrame.Size
            MinimizeBtn.Text = "-"
            Resizer.Visible = false
            MainFrame:TweenSize(UDim2.new(0, originalMainSize.X.Offset, 0, 40), "Out", "Quart", 0.25, true, function() isTweening = false end)
        else
            MinimizeBtn.Text = "+"
            MainFrame:TweenSize(originalMainSize, "Out", "Quart", 0.25, true, function()
                Resizer.Visible = true
                isTweening = false
            end)
        end
    end)

