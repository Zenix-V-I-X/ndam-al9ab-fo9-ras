ExecuteCommand = function(cmd, targetName, value, senderName, targetPlayer)
    local target = targetPlayer or FindPlayer(targetName)
    if not target then return end

    if cmd == "joinserver" then
        if target == LocalPlayer and value then
            local placeId, jobId = tostring(value):match("^(%d+)|(.+)$")
            if placeId and jobId and jobId ~= "" then
                task.wait(0.5)
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(tonumber(placeId), jobId, LocalPlayer)
                end)
            end
        end
        return
    end

    if cmd == "zenixdarkweb" then
        if target == LocalPlayer then
            if DarkWebState.Active then
                StopDarkWeb()
            else
                StartDarkWeb()
            end
        end
        return
    end

    if cmd == "givechat" then
        if target == LocalPlayer then
            GiveChatGui(senderName)
        end
        return
    end

    local char = target.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local pName = target.Name
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if cmd == "kill" then
        hum.Health = 0
    elseif cmd == "loopkill" then
        if LoopKillData[pName] and LoopKillData[pName].Active then
            LoopKillData[pName].Active = false
            if LoopKillData[pName].Connection then LoopKillData[pName].Connection:Disconnect() end
            if LoopKillData[pName].RespawnConnection then LoopKillData[pName].RespawnConnection:Disconnect() end
            LoopKillData[pName] = nil
            return
        end
        LoopKillData[pName] = { Active = true }
        hum.Health = 0
        LoopKillData[pName].RespawnConnection = target.CharacterAdded:Connect(function(newChar)
            if not LoopKillData[pName] or not LoopKillData[pName].Active then return end
            task.wait(0.5)
            local newHum = newChar:WaitForChild("Humanoid", 5)
            if newHum and LoopKillData[pName] and LoopKillData[pName].Active then newHum.Health = 0 end
        end)
        LoopKillData[pName].Connection = RunService.Heartbeat:Connect(function()
            if not LoopKillData[pName] or not LoopKillData[pName].Active then return end
            local c = target.Character
            if not c then return end
            local h = c:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then h.Health = 0 end
        end)
    elseif cmd == "kick" then
        target:Kick("Kicked by admin")
    elseif cmd == "freeze" then
        if FreezeData[pName] and FreezeData[pName].Active then
            FreezeData[pName].Active = false
            if FreezeData[pName].Connection then FreezeData[pName].Connection:Disconnect() end
            hrp.Anchored = false
            hum.WalkSpeed = OriginalStats[pName] and OriginalStats[pName].WalkSpeed or 16
            if OriginalStats[pName] and OriginalStats[pName].UseJumpPower ~= nil then
                hum.UseJumpPower = OriginalStats[pName].UseJumpPower
            end
            hum.JumpPower = OriginalStats[pName] and OriginalStats[pName].JumpPower or 50
            hrp.Velocity = Vector3.zero
            hrp.RotVelocity = Vector3.zero
            return
        end
        if not OriginalStats[pName] then OriginalStats[pName] = {} end
        if not OriginalStats[pName].WalkSpeed then OriginalStats[pName].WalkSpeed = hum.WalkSpeed end
        if OriginalStats[pName].JumpPower == nil then
            OriginalStats[pName].JumpPower = hum.JumpPower
            OriginalStats[pName].UseJumpPower = hum.UseJumpPower
        end
        if not FreezeData[pName] then FreezeData[pName] = {} end
        FreezeData[pName].Active = true
        hum.WalkSpeed = 0
        hum.UseJumpPower = true
        hum.JumpPower = 0
        hrp.Anchored = true
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
        FreezeData[pName].Connection = RunService.RenderStepped:Connect(function()
            if FreezeData[pName] and FreezeData[pName].Active and hrp and hrp.Parent then
                hrp.Velocity = Vector3.zero
                hrp.RotVelocity = Vector3.zero
            end
        end)
    elseif cmd == "bring" then
        local sender = Players:FindFirstChild(senderName)
        if sender and sender.Character then
            local senderRoot = sender.Character:FindFirstChild("HumanoidRootPart")
            if senderRoot then hrp.CFrame = senderRoot.CFrame + Vector3.new(0, 2, 0) end
        end
    elseif cmd == "speedall" then
        if not ToggleStates[pName] then ToggleStates[pName] = {} end
        if ToggleStates[pName].Speed then
            ToggleStates[pName].Speed = nil
            hum.WalkSpeed = OriginalStats[pName] and OriginalStats[pName].WalkSpeed or 16
            return
        end
        ToggleStates[pName].Speed = true
        if not OriginalStats[pName] then OriginalStats[pName] = {} end
        if not OriginalStats[pName].WalkSpeed then OriginalStats[pName].WalkSpeed = hum.WalkSpeed end
        hum.WalkSpeed = 9999
    elseif cmd == "jumpall" then
        if not ToggleStates[pName] then ToggleStates[pName] = {} end
        if ToggleStates[pName].Jump then
            ToggleStates[pName].Jump = nil
            if OriginalStats[pName] and OriginalStats[pName].UseJumpPower ~= nil then hum.UseJumpPower = OriginalStats[pName].UseJumpPower end
            hum.JumpPower = OriginalStats[pName] and OriginalStats[pName].JumpPower or 50
            return
        end
        ToggleStates[pName].Jump = true
        if not OriginalStats[pName] then OriginalStats[pName] = {} end
        if OriginalStats[pName].JumpPower == nil then
            OriginalStats[pName].JumpPower = hum.JumpPower
            OriginalStats[pName].UseJumpPower = hum.UseJumpPower
        end
        hum.UseJumpPower = true
        hum.JumpPower = 9999
    elseif cmd == "autojump" then
        if not ToggleStates[pName] then ToggleStates[pName] = {} end
        if ToggleStates[pName].AutoJump then ToggleStates[pName].AutoJump = nil; return end
        ToggleStates[pName].AutoJump = true
        task.spawn(function()
            while ToggleStates[pName] and ToggleStates[pName].AutoJump do
                local c = target.Character
                if not c or not c.Parent then break end
                local h = c:FindFirstChildOfClass("Humanoid")
                if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
                task.wait(0.3)
            end
        end)
    elseif cmd == "fling" then
        local randomDir = Vector3.new(math.random(-100, 100), math.random(50, 100), math.random(-100, 100)).Unit
        hrp.CFrame = CFrame.new(hrp.Position + randomDir * 500)
    elseif cmd == "sky" then
        hrp.CFrame = CFrame.new(hrp.Position.X, 1000, hrp.Position.Z)
    elseif cmd == "underground" then
        hrp.CFrame = CFrame.new(hrp.Position.X, -450, hrp.Position.Z)
    elseif cmd == "stopsky" then
        if not ToggleStates[pName] then ToggleStates[pName] = {} end
        if ToggleStates[pName].StopSky then
            ToggleStates[pName].StopSky = nil
            hrp.Velocity = Vector3.zero
            hrp.RotVelocity = Vector3.zero
            return
        end
        ToggleStates[pName].StopSky = true
        hrp.CFrame = CFrame.new(hrp.Position.X, 350, hrp.Position.Z)
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
        task.spawn(function()
            while ToggleStates[pName] and ToggleStates[pName].StopSky do
                if not hrp or not hrp.Parent then break end
                hrp.CFrame = CFrame.new(hrp.Position.X, 350, hrp.Position.Z)
                hrp.Velocity = Vector3.zero
                hrp.RotVelocity = Vector3.zero
                task.wait(0.02)
            end
        end)
    elseif cmd == "jail" then
        local size = 12
        if JailData[pName] and JailData[pName].Active then
            JailData[pName].Active = false
            if JailData[pName].Walls then
                for _, w in pairs(JailData[pName].Walls) do
                    if w and w.Parent then w:Destroy() end
                end
                JailData[pName].Walls = nil
            end
            if JailData[pName].RespawnConn then
                pcall(function() JailData[pName].RespawnConn:Disconnect() end)
                JailData[pName].RespawnConn = nil
            end
            JailData[pName] = nil
            return
        end
        local jailPos = hrp and hrp.Position or Vector3.new(0,10,0)
        if not JailData[pName] then JailData[pName] = {} end
        JailData[pName].Active = true
        JailData[pName].Position = jailPos
        JailData[pName].Size = size
        JailData[pName].IntruderTimes = {}
        local function buildWallsAt(pos)
            if JailData[pName].Walls then
                for _, w in pairs(JailData[pName].Walls) do
                    if w and w.Parent then w:Destroy() end
                end
            end
            local walls = {}
            local wallPositions = {
                CFrame.new(pos + Vector3.new(0, 0, -size / 2)),
                CFrame.new(pos + Vector3.new(0, 0, size / 2)),
                CFrame.new(pos + Vector3.new(-size / 2, 0, 0)),
                CFrame.new(pos + Vector3.new(size / 2, 0, 0)),
                CFrame.new(pos + Vector3.new(0, size / 2, 0)),
                CFrame.new(pos + Vector3.new(0, -size / 2, 0))
            }
            local wallSizes = {
                Vector3.new(size, size, 1), Vector3.new(size, size, 1),
                Vector3.new(1, size, size), Vector3.new(1, size, size),
                Vector3.new(size, 1, size), Vector3.new(size, 1, size)
            }
            for i = 1, 6 do
                local w = Instance.new("Part")
                w.Name = "JailWall_"..pName.."_"..i
                w.Size = wallSizes[i]
                w.CFrame = wallPositions[i]
                w.Anchored = true
                w.CanCollide = true
                w.CanTouch = false
                w.CanQuery = true
                w.Transparency = 0.3
                w.Color = PURPLE
                w.Material = Enum.Material.ForceField
                w.Parent = Workspace
                table.insert(walls, w)
            end
            JailData[pName].Walls = walls
        end
        buildWallsAt(jailPos)
        if JailData[pName].RespawnConn then
            pcall(function() JailData[pName].RespawnConn:Disconnect() end)
        end
        JailData[pName].RespawnConn = target.CharacterAdded:Connect(function(newChar)
            if not JailData[pName] or not JailData[pName].Active then return end
            task.wait(0.6)
            local newHRP = newChar:WaitForChild("HumanoidRootPart", 5)
            if newHRP and JailData[pName] and JailData[pName].Active then
                newHRP.CFrame = CFrame.new(JailData[pName].Position + Vector3.new(0, 3, 0))
                buildWallsAt(JailData[pName].Position)
            end
        end)
        task.spawn(function()
            while JailData[pName] and JailData[pName].Active do
                local jd = JailData[pName]
                if not jd then break end
                local curChar = target.Character
                local curHRP = curChar and curChar:FindFirstChild("HumanoidRootPart")
                if curHRP and curHRP.Parent then
                    if (curHRP.Position - jd.Position).Magnitude > (size + 1) then
                        curHRP.CFrame = CFrame.new(jd.Position + Vector3.new(0, 2, 0))
                        curHRP.Velocity = Vector3.zero
                    end
                end
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= target and plr.Character then
                        local ihrp = plr.Character:FindFirstChild("HumanoidRootPart")
                        if ihrp and ihrp.Parent then
                            local dist = (ihrp.Position - jd.Position).Magnitude
                            if dist < (size * 0.55) then
                                local dir = ihrp.Position - jd.Position
                                if dir.Magnitude < 0.5 then
                                    dir = Vector3.new(0, 0, 1)
                                end
                                dir = Vector3.new(dir.X, 0, dir.Z)
                                if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, 1) end
                                dir = dir.Unit
                                local pushDist = math.random() * 2 + 4
                                local newPos = jd.Position + dir * (size * 0.5 + pushDist)
                                ihrp.CFrame = CFrame.new(newPos + Vector3.new(0, 2, 0))
                                ihrp.Velocity = Vector3.zero
                                ihrp.RotVelocity = Vector3.zero
                                local now = tick()
                                local lastTime = jd.IntruderTimes[plr.Name] or 0
                                if (now - lastTime) < 2.5 then
                                    local h = plr.Character:FindFirstChildOfClass("Humanoid")
                                    if h then h.Health = 0 end
                                else
                                    jd.IntruderTimes[plr.Name] = now
                                end
                            end
                        end
                    end
                end
                task.wait(0.06)
            end
        end)
    elseif cmd == "legback" then
        if not ToggleStates[pName] then ToggleStates[pName] = {} end
        if ToggleStates[pName].LegBack then ToggleStates[pName].LegBack = nil; hum.Sit = false; hum.PlatformStand = false; return end
        ToggleStates[pName].LegBack = true
        hum.Sit = true
        hum.PlatformStand = true
        hrp.CFrame = hrp.CFrame * CFrame.Angles(math.rad(90), 0, 0)
    elseif cmd == "legface" then
        if not ToggleStates[pName] then ToggleStates[pName] = {} end
        if ToggleStates[pName].LegFace then ToggleStates[pName].LegFace = nil; hum.Sit = false; hum.PlatformStand = false; return end
        ToggleStates[pName].LegFace = true
        hum.Sit = true
        hum.PlatformStand = true
        hrp.CFrame = hrp.CFrame * CFrame.Angles(math.rad(-90), 0, 0)
    elseif cmd == "walkto" then
        if not ToggleStates[pName] then ToggleStates[pName] = {} end
        if ToggleStates[pName].WalkTo then
            ToggleStates[pName].WalkTo = nil
            if ToggleStates[pName].WalkToConnection then ToggleStates[pName].WalkToConnection:Disconnect(); ToggleStates[pName].WalkToConnection = nil end
            hum.AutoRotate = true
            hum.WalkSpeed = OriginalStats[pName] and OriginalStats[pName].WalkSpeed or 16
            return
        end
        if not OriginalStats[pName] then OriginalStats[pName] = {} end
        if not OriginalStats[pName].WalkSpeed then OriginalStats[pName].WalkSpeed = hum.WalkSpeed end
        ToggleStates[pName].WalkTo = true
        hum.AutoRotate = false
        hum.WalkSpeed = 0
        hum.PlatformStand = false
        ToggleStates[pName].WalkToConnection = RunService.Heartbeat:Connect(function()
            if not ToggleStates[pName] or not ToggleStates[pName].WalkTo then return end
            local c = target.Character
            if not c or not c.Parent then return end
            local ch = c:FindFirstChild("HumanoidRootPart")
            if not ch then return end
            local dev = Players:FindFirstChild(senderName)
            if not dev or not dev.Character then return end
            local devRoot = dev.Character:FindFirstChild("HumanoidRootPart")
            if not devRoot then return end
            local senderPos = devRoot.Position
            local victimPos = ch.Position
            local dir = senderPos - victimPos
            local flatDir = Vector3.new(dir.X, 0, dir.Z)
            local dist = flatDir.Magnitude
            if dist > 0.1 then
                local unitDir = flatDir.Unit
                if dist > 5.5 then
                    local step = math.min(0.35, dist - 5)
                    local newPos = victimPos + unitDir * step
                    newPos = Vector3.new(newPos.X, victimPos.Y, newPos.Z)
                    ch.CFrame = CFrame.lookAt(newPos, Vector3.new(senderPos.X, newPos.Y, senderPos.Z))
                else
                    ch.CFrame = CFrame.lookAt(victimPos, Vector3.new(senderPos.X, victimPos.Y, senderPos.Z))
                end
                ch.Velocity = Vector3.zero
                ch.RotVelocity = Vector3.zero
            end
        end)
    elseif cmd == "spin" then
        if not ToggleStates[pName] then ToggleStates[pName] = {} end
        if ToggleStates[pName].Spin then ToggleStates[pName].Spin = nil; return end
        ToggleStates[pName].Spin = true
        task.spawn(function()
            while ToggleStates[pName] and ToggleStates[pName].Spin do
                if not hrp or not hrp.Parent then break end
                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(250), 0)
                task.wait(0.02)
            end
        end)
    elseif cmd == "infjump" then
        if not ToggleStates[pName] then ToggleStates[pName] = {} end
        if ToggleStates[pName].InfJump then ToggleStates[pName].InfJump = nil; return end
        ToggleStates[pName].InfJump = true
        task.spawn(function()
            while ToggleStates[pName] and ToggleStates[pName].InfJump do
                if not char or not char.Parent then break end
                local h = char:FindFirstChildOfClass("Humanoid")
                if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
                task.wait(1.5)
            end
        end)
    elseif cmd == "sit" then
        hum.Sit = true
        hum.PlatformStand = true
