    NotfHeader.Parent = NotificationsTab

    local NotfVictimBox = createStyledTextBox(NotfHeader, "اسم الضحية (يجب أن يكون مفعل السكربت)...")
    NotfVictimBox.Position = UDim2.new(0.025, 0, 0, 4)

    local NotfMsgBox = createStyledTextBox(NotfHeader, "اكتب الرسالة هنا...")
    NotfMsgBox.Position = UDim2.new(0.025, 0, 0, 44)
    NotfMsgBox.Size = UDim2.new(0.95, 0, 0, 80)
    NotfMsgBox.MultiLine = true
    NotfMsgBox.TextWrapped = true

    local NotfScroll = Instance.new("ScrollingFrame")
    NotfScroll.Size = UDim2.new(1, 0, 1, -135)
    NotfScroll.Position = UDim2.new(0, 0, 0, 135)
    NotfScroll.BackgroundTransparency = 1
    NotfScroll.ScrollBarThickness = 6
    NotfScroll.ScrollBarImageColor3 = PURPLE
    NotfScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    NotfScroll.ScrollingEnabled = true
    NotfScroll.Parent = NotificationsTab

    local NotfLayout = Instance.new("UIListLayout", NotfScroll)
    NotfLayout.Padding = UDim.new(0, 6)
    NotfLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    NotfLayout.SortOrder = Enum.SortOrder.LayoutOrder
    NotfLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        NotfScroll.CanvasSize = UDim2.new(0, 0, 0, NotfLayout.AbsoluteContentSize.Y + 10)
    end)

    createStyledButton(NotfScroll, "ارسال الاشعارات", function()
        local p = FindPlayer(NotfVictimBox.Text)
        if p and NotfMsgBox.Text and NotfMsgBox.Text ~= "" then
            SendCommandAPI("notf", p.Name, NotfMsgBox.Text)
        end
    end)
    createStyledButton(NotfScroll, "ايقاف الاشعارات", function()
        local p = FindPlayer(NotfVictimBox.Text)
        if p then SendCommandAPI("notfstop", p.Name, nil) end
    end)

    local HouseHeader = Instance.new("Frame")
    HouseHeader.Size = UDim2.new(1, 0, 0, 42)
    HouseHeader.BackgroundTransparency = 1
    HouseHeader.Parent = HousesTab

    local HouseVictimBox = createStyledTextBox(HouseHeader, "اسم الضحية...")
    HouseVictimBox.Position = UDim2.new(0.025, 0, 0, 4)

    local HouseScroll = Instance.new("ScrollingFrame")
    HouseScroll.Size = UDim2.new(1, 0, 1, -48)
    HouseScroll.Position = UDim2.new(0, 0, 0, 48)
    HouseScroll.BackgroundTransparency = 1
    HouseScroll.ScrollBarThickness = 6
    HouseScroll.ScrollBarImageColor3 = PURPLE
    HouseScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    HouseScroll.ScrollingEnabled = true
    HouseScroll.Parent = HousesTab

    local HouseLayout = Instance.new("UIListLayout", HouseScroll)
    HouseLayout.Padding = UDim.new(0, 6)
    HouseLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    HouseLayout.SortOrder = Enum.SortOrder.LayoutOrder
    HouseLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        HouseScroll.CanvasSize = UDim2.new(0, 0, 0, HouseLayout.AbsoluteContentSize.Y + 10)
    end)

    local housesData = {
        { "Castle", "castle" },
        { "Blox Fruit", "bloxfruit" },
        { "MM2", "mm2" },
        { "سوق", "market" },
        { "حديقة", "garden" },
        { "بيت", "house" },
        { "Dark Garden", "darkgarden" },
    }
    for _, data in ipairs(housesData) do
        local cmd = data[2]
        local btn = createStyledButton(HouseScroll, data[1], function()
            local p = FindPlayer(HouseVictimBox.Text)
            if p then SendCommandAPI(cmd, p.Name, nil) end
        end)
        btn.Size = UDim2.new(0.9, 0, 0, 35)
    end

    ScreenGui.Destroying:Connect(function()
        for _, p in ipairs(Players:GetPlayers()) do
            if BangState[p.Name] then StopBangFor(p) end
            if CamState[p.Name] then StopCam(p.Name) end
        end
    end)

    task.spawn(function()
        while ScreenGui and ScreenGui.Parent do
            MainFrame.BackgroundTransparency = 0.15 + 0.05 * math.sin(tick() * 2)
            task.wait(0.1)
        end
    end)
end
