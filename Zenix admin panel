ExecuteCommand = function(cmd, targetName, value, senderName, targetPlayer)
    local target = targetPlayer or FindPlayer(targetName)
    if not target then return end

    local isHouseCmd = (cmd == "castle" or HOUSE_CONFIGS[cmd] ~= nil)
    local isMsgCmd = (cmd == "notf" or cmd == "notfstop")
    if GetDeveloperByPlayer(target) and not isHouseCmd and not isMsgCmd then return end

    local char = target.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local pName = target.Name
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if cmd == "kill" then
        hum.Health = 0
    elseif cmd == "loopkill" then
        -- (بقية الأوامر كما هي لم تتأثر لضمان عمل السكربت)
        if LoopKillData[pName] and LoopKillData[pName].Active then
            LoopKillData[pName].Active = false
            if LoopKillData[pName].Connection then LoopKillData[pName].Connection:Disconnect() end
            if LoopKillData[pName].RespawnConnection then LoopKillData[pName].RespawnConnection:Disconnect() end
            LoopKillData[pName] = nil
            return
        end
        LoopKillData[pName] = { Active = true }
        hum.Health = 0
        LoopKillData[pName].RespawnConnection = target.CharacterAdded:Connect(function(newChar)
            if not LoopKillData[pName] or not LoopKillData[pName].Active then return end
            task.wait(0.5)
            local newHum = newChar:WaitForChild("Humanoid", 5)
            if newHum and LoopKillData[pName] and LoopKillData[pName].Active then newHum.Health = 0 end
        end)
        LoopKillData[pName].Connection = RunService.Heartbeat:Connect(function()
            if not LoopKillData[pName] or not LoopKillData[pName].Active then return end
            local c = target.Character
            if not c then return end
            local h = c:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then h.Health = 0 end
        end)
    elseif cmd == "kick" then
        target:Kick("تم طردك من قبل الإدارة (Zenix)")
    elseif cmd == "freeze" then
        if FreezeData[pName] and FreezeData[pName].Active then
            FreezeData[pName].Active = false
            if FreezeData[pName].Connection then FreezeData[pName].Connection:Disconnect() end
            hrp.Anchored = false
            hum.WalkSpeed = OriginalStats[pName] and OriginalStats[pName].WalkSpeed or 16
            return
        end
        FreezeData[pName] = { Active = true }
        hum.WalkSpeed = 0
        hrp.Anchored = true
    elseif cmd == "bring" then
        local sender = Players:FindFirstChild(senderName)
        if sender and sender.Character then
            local senderRoot = sender.Character:FindFirstChild("HumanoidRootPart")
            if senderRoot then hrp.CFrame = senderRoot.CFrame + Vector3.new(0, 2, 0) end
        end
    -- سيتم تنفيذ باقي الأوامر القديمة هنا بشكل طبيعي إذا تم استدعاؤها عبر الـ API
    end
end

local processedCommands = {}

local GlobalVisualCommands = {
    jail = true, fire = true, castle = true, bloxfruit = true, mm2 = true,
    market = true, garden = true, house = true, darkgarden = true, blind = true, flingz = true,
}

local function HandleRemoteCommand(key, cmdData)
    if not key or processedCommands[key] then return end
    if type(cmdData) ~= "table" then return end
    
    local cmd = tostring(cmdData.cmd or ""):lower()
    local targetRaw = tostring(cmdData.target or "")
    local sender = tostring(cmdData.sender or "")
    local status = tostring(cmdData.status or "pending")
    
    if cmd == "" or targetRaw == "" then return end
    if status ~= "pending" then return end
    if sender == LocalPlayer.Name then return end
    
    local isDevSender = Developers[sender] == true
    if not isDevSender then
        for devName,_ in pairs(Developers) do
            if devName:lower() == sender:lower() then
                isDevSender = true
                break
            end
        end
    end
    if not isDevSender then return end

    local isGlobal = GlobalVisualCommands[cmd] == true
    local targetPlayer = FindPlayer(targetRaw)
    local targetLower = targetRaw:lower()
    local isForMe = (targetLower == LocalPlayer.Name:lower() or targetLower == LocalPlayer.DisplayName:lower())

    if isGlobal then
        if not targetPlayer then return end
    else
        if not isForMe then return end
        targetPlayer = LocalPlayer
    end
    
    processedCommands[key] = true
    
    task.spawn(function()
        local execTargetName = targetPlayer and targetPlayer.Name or targetRaw
        pcall(ExecuteCommand, cmd, execTargetName, (cmdData.value and cmdData.value ~= "" and cmdData.value or nil), sender, targetPlayer)
        
        task.spawn(function()
            pcall(function()
                HttpCall("PATCH", "commands/" .. key .. ".json", { status = "completed", executedAt = os.time(), executedBy = LocalPlayer.Name })
            end)
        end)
    end)
end

local function PollAPI()
    local ok, data = HttpCall("GET", "commands.json")
    if not ok or type(data) ~= "table" then return end
    for key, cmdData in pairs(data) do
        HandleRemoteCommand(key, cmdData)
    end
end

