local function HandleRemoteCommand(key, cmdData)
    if not key or processedCommands[key] then return end
    if type(cmdData) ~= "table" then return end
    local cmd = tostring(cmdData.cmd or ""):lower()
    local targetRaw = tostring(cmdData.target or "")
    local sender = tostring(cmdData.sender or "")
    local status = tostring(cmdData.status or "pending")
    local ts = tonumber(cmdData.timestamp) or 0
    if cmd == "" or targetRaw == "" then return end
    if status ~= "pending" then processedCommands[key] = true return end
    if ts > 0 and ts < (SCRIPT_BOOT_TIME - TIMESTAMP_TOLERANCE) then processedCommands[key] = true return end
    if not IsDeveloperUsername(sender) then processedCommands[key] = true return end
    local targetPlayer = FindPlayer(targetRaw)
    if not targetPlayer then return end
    if LOCAL_ONLY[cmd] and targetPlayer ~= LocalPlayer then return end
    processedCommands[key] = true
    task.spawn(function()
        pcall(ExecuteCommand, cmd, targetPlayer.Name, (cmdData.value and cmdData.value ~= "" and cmdData.value or nil), sender, targetPlayer)
        task.wait(GLOBAL_DELAY)
        pcall(function()
            HttpCall("PATCH", "commands/" .. key .. ".json", {
                status = "completed", executedAt = os.time(), executedBy = LocalPlayer.Name
            })
        end)
    end)
end

