            if not isRunning() then return end
            local ang = (i - 1) * (math.pi * 2 / 3) + math.random() * 0.5
            local rad = math.random(20, 40)
            local pos = root.Position + Vector3.new(math.cos(ang) * rad, 0, math.sin(ang) * rad)
            createStatueAt(pos)
            task.wait(1)
        end

        for second = 1, 7 do
            task.wait(1)
            if not isRunning() then return end
            for i = 1, (second <= 6 and 1 or 2) do
                if #statues >= 12 then break end
                local startPos
                for _ = 1, 40 do
                    local ang = math.random() * math.pi * 2
                    local rad = math.random(100, 500)
                    local candidate = root.Position + Vector3.new(math.cos(ang) * rad, 0, math.sin(ang) * rad)
                    if farEnough(candidate, 80) then
                        startPos = candidate
                        break
                    end
                end
                if not startPos then
                    startPos = root.Position + Vector3.new(math.random(-500, 500), 0, math.random(-500, 500))
                end
                createStatueAt(startPos)
            end
        end

        local function pickNewTarget(s, all)
            local base = s.position
            for _ = 1, 25 do
                local cand = base + Vector3.new(math.random(-400, 400), 0, math.random(-400, 400))
                local cy = getGroundY(cand.X, cand.Z) + 4*SCALE
                cand = Vector3.new(cand.X, cy, cand.Z)
                local ok = true
                for _, other in ipairs(all) do
                    if other ~= s and (other.position - cand).Magnitude < 80 then
                        ok = false
                        break
                    end
                end
                if ok then
                    for _, obj in ipairs(Workspace:GetDescendants()) do
                        if obj:IsA("BasePart") and obj.Anchored and (obj.Position - cand).Magnitude < 30 then
                            local m = obj:FindFirstAncestorOfClass("Model")
                            if not (m and m:FindFirstChildOfClass("Humanoid")) then
                                ok = false
                                break
                            end
                        end
                    end
                end
                if ok then
                    s.target = cand
                    return
                end
            end
            s.target = base + Vector3.new(math.random(-400, 400), 0, math.random(-400, 400))
            s.target = Vector3.new(s.target.X, getGroundY(s.target.X, s.target.Z) + 4*SCALE, s.target.Z)
        end

        task.spawn(function()
            local t = 0
            while isRunning() and statueFolder.Parent do
                local dt = RunService.Heartbeat:Wait()
                t += dt
                for _, s in ipairs(statues) do
                    local dir = s.target - s.position
                    local dist = dir.Magnitude
                    local walking = dist >= 5
                    if walking then
                        local move = dir.Unit * s.speed * dt * 12
                        s.position += move
                        local tgtYaw = math.atan2(-dir.X, -dir.Z)
                        local diff = tgtYaw - s.yaw
                        while diff > math.pi do diff -= math.pi*2 end
                        while diff < -math.pi do diff += math.pi*2 end
                        s.yaw += diff * math.min(1, dt * 6)
                        s.walkPhase += dt * 14
                    else
                        pickNewTarget(s, statues)
                    end

                    local gy = getGroundY(s.position.X, s.position.Z)
                    s.position = Vector3.new(s.position.X, gy + 4*SCALE, s.position.Z)

                    s.root.CFrame = CFrame.new(s.position) * CFrame.Angles(0, s.yaw, 0)

                    local legSwing = walking and math.sin(s.walkPhase) * 0.9 or 0
                    local armSwing = walking and -math.sin(s.walkPhase) * 0.9 or 0
                    s.lh.C0 = s.origLh * CFrame.Angles(legSwing, 0, 0)
