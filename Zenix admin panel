local function StopBangFor(player)
    if not player then return end
    local pName = player.Name
    if BangState[pName] then
        if BangState[pName].Connection then BangState[pName].Connection:Disconnect() end
        BangState[pName] = nil
    end
end

local function StartBang(player, targetPlayer, mode)
    if not player or not targetPlayer or player == targetPlayer then return end
    local pName = player.Name
    if BangState[pName] then StopBangFor(player) end
    if not targetPlayer.Character or not player.Character then return end
    local tHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    if not tHRP or not hrp or not hum then return end
    BangState[pName] = { Active = true, Mode = mode, Target = targetPlayer }
    hum.PlatformStand = true
    hum.AutoRotate = false
    for _, part in ipairs(player.Character:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end
    BangState[pName].Connection = RunService.Heartbeat:Connect(function()
        if not BangState[pName] or not BangState[pName].Active then return end
        local target = BangState[pName].Target
        if not target or not target.Character then return end
        local thrp = target.Character:FindFirstChild("HumanoidRootPart")
        local th = target.Character:FindFirstChild("Head")
        if not thrp then return end
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
        local w = math.sin(tick() * 55)
        local dr = w * 4.5
        local nr = w * 2.5
        if mode == "face" and th then
            hrp.CFrame = th.CFrame * CFrame.new(0, -0.6, dr) * CFrame.Angles(0, math.rad(180), 0)
        elseif mode == "back" then
            hrp.CFrame = thrp.CFrame * CFrame.new(0, 0.5, nr + 1.2)
        elseif mode == "combined" then
            if math.floor(tick() * 60) % 2 == 0 then
                if th then hrp.CFrame = th.CFrame * CFrame.new(0, -0.6, dr) * CFrame.Angles(0, math.rad(180), 0) end
            else
                hrp.CFrame = thrp.CFrame * CFrame.new(0, 0.5, dr + 1.5)
            end
        end
    end)
end

