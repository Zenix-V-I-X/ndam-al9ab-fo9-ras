local function LoadProcessedFromDisk()
    if not (readfile and isfile) then return end
    local ok, data = pcall(function()
        if isfile(PROCESSED_FILE) then
            return HttpService:JSONDecode(readfile(PROCESSED_FILE))
        end
    end)
    if ok and type(data) == "table" then
        for k in pairs(data) do
            processedCommands[k] = true
        end
    end
end

local function SaveProcessedToDisk()
    if not writefile then return end
    local out = {}
    local n = 0
    for k in pairs(processedCommands) do
        out[k] = true
        n = n + 1
        if n >= PROCESSED_CAP then break end
    end
    pcall(function()
        writefile(PROCESSED_FILE, HttpService:JSONEncode(out))
    end)
end

local function MarkProcessed(key)
    if not key or processedCommands[key] then return end
    processedCommands[key] = true
    task.spawn(SaveProcessedToDisk)
end

