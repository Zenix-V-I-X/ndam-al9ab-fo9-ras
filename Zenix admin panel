local function FindPlayer(targetName)
    if not targetName or targetName == "" then return nil end
    local lower = targetName:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == lower or p.DisplayName:lower() == lower then
            return p
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(lower, 1, true) or p.DisplayName:lower():find(lower, 1, true) then
            return p
        end
    end
    return nil
end

local function GetDeveloperByPlayer(player)
    if not player then return false end
    return Developers[player.Name] == true
end

local function SendCommand(cmd, targetName, value, targetPlayer)
    if not targetName then return end
    if not IsDeveloper then return end
    
    local chatMsg = "/" .. cmd .. " " .. targetName
    if value and value ~= "" then
        chatMsg = chatMsg .. " " .. value
    end
    
    if TextChatService and TextChatService.TextChannels and TextChatService.TextChannels.RBXGeneral then
        pcall(function() TextChatService.TextChannels.RBXGeneral:SendAsync(chatMsg) end)
    end
end

