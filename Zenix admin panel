    local function RefreshPlayersTab(scroll)
        for _, c in ipairs(scroll:GetChildren()) do
            if c:IsA("Frame") then c:Destroy() end
        end
        local ok, data = HttpCall("GET", "players.json")
        if not ok or type(data) ~= "table" then return end
        local now = os.time()
        local list = {}
        for username, pdata in pairs(data) do
            if type(pdata) == "table" then
                pdata.username = username
                local ls = tonumber(pdata.lastSeen) or 0
                local isOnline = (now - ls) <= OFFLINE_THRESHOLD
                pdata.status = isOnline and "online" or "offline"
                if (now - ls) > OFFLINE_EXPIRY then
                    task.spawn(function()
                        HttpCall("DELETE", "players/" .. username .. ".json", nil)
                    end)
                else
                    table.insert(list, pdata)
                end
            end
        end
        table.sort(list, function(a, b)
            if a.status ~= b.status then return a.status == "online" end
            return (a.username or "") < (b.username or "")
        end)
        for _, pdata in ipairs(list) do
            CreatePlayerCardUI(scroll, pdata, false)
        end
    end

