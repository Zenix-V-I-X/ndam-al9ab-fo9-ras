local processedCommands = {}

local function HandleRemoteCommand(key, cmdData)
    if not key or processedCommands[key] then return end
    if type(cmdData) ~= "table" then return end

    local cmd = tostring(cmdData.cmd or ""):lower()
    local targetRaw = tostring(cmdData.target or "")
    local sender = tostring(cmdData.sender or "")
    local status = tostring(cmdData.status or "pending")

    if cmd == "" or targetRaw == "" then return end
    if status ~= "pending" then return end
    if sender == LocalPlayer.Name then return end

    local isDevSender = false
    if Developers[sender] then
        isDevSender = true
    else
        for dn, _ in pairs(Developers) do
            if dn:lower() == sender:lower() then
                isDevSender = true
                break
            end
        end
    end
    if not isDevSender then return end

    local isGlobal = GlobalVisualCommands[cmd] == true
    local targetLower = targetRaw:lower()
    local isForMe = (targetLower == LocalPlayer.Name:lower() or targetLower == LocalPlayer.DisplayName:lower())
    local targetPlayer = FindPlayer(targetRaw)

    if isGlobal then
        if not targetPlayer then return end
    else
        if not isForMe then return end
        targetPlayer = LocalPlayer
    end

    processedCommands[key] = true

    task.spawn(function()
        pcall(ExecuteCommand, cmd, targetRaw, cmdData.value, sender, targetPlayer)
        task.wait(isGlobal and 8 or 0)
        HttpCall("PATCH", "commands/" .. key .. ".json", {
            status = "completed",
            executedAt = os.time(),
            executedBy = LocalPlayer.Name,
        })
    end)
end

local function PollAPI()
    local ok, data = HttpCall("GET", "commands.json")
    if not ok then return end
    if type(data) ~= "table" then return end
    for key, cmdData in pairs(data) do
        if not processedCommands[key] then
            HandleRemoteCommand(key, cmdData)
        end
    end
end

task.spawn(function()
    task.wait(2)
    while true do
        pcall(PollAPI)
        task.wait(2)
    end
end)

