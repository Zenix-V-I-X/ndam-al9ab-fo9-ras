local BangState = {}

local function StopBangFor(player)
    if not player then return end
    local pName = player.Name
    if BangState[pName] then
        BangState[pName].Active = false
        if BangState[pName].Connection then
            BangState[pName].Connection:Disconnect()
            BangState[pName].Connection = nil
        end
        local char = player.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hrp then
                hrp.Velocity = Vector3.zero
                hrp.RotVelocity = Vector3.zero
            end
            if hum then
                hum.PlatformStand = false
                hum.AutoRotate = true
            end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
        BangState[pName] = nil
    end
end

local function StartBang(player, targetPlayer, mode)
    if not player or not targetPlayer then return end
    if player == targetPlayer then return end
    
    local pName = player.Name
    
    if BangState[pName] and BangState[pName].Active and BangState[pName].Mode == mode then
        StopBangFor(player)
        return
    end
    
    if BangState[pName] and BangState[pName].Active then
        StopBangFor(player)
    end
    
    if not targetPlayer.Character then return end
    local tHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    local tHead = targetPlayer.Character:FindFirstChild("Head")
    if not tHRP then return end
    
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    
    BangState[pName] = {
        Active = true,
        Mode = mode,
        Target = targetPlayer,
        Connection = nil
    }
    
    hum.PlatformStand = true
    hum.AutoRotate = false
    
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
    
    BangState[pName].Connection = RunService.Stepped:Connect(function()
        local state = BangState[pName]
        if not state or not state.Active then return end
        
        local target = state.Target
        if not target or not target.Character then return end
        local tc = target.Character
        local thrp = tc:FindFirstChild("HumanoidRootPart")
        local th = tc:FindFirstChild("Head")
        if not thrp then return end
        
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
        
        local w = math.sin(tick() * 55)
        local dr = w * 4.5
        local nr = w * 2.5
        
        local currentMode = state.Mode
        
        if currentMode == "combined" then
            if math.floor(tick() * 60) % 2 == 0 then
                if th then
                    hrp.CFrame = th.CFrame * CFrame.new(0, -0.6, dr) * CFrame.Angles(0, math.rad(180), 0)
                end
            else
                hrp.CFrame = thrp.CFrame * CFrame.new(0, 0.5, dr + 1.5)
            end
        elseif currentMode == "face" then
            if th then
                hrp.CFrame = th.CFrame * CFrame.new(0, -0.6, dr) * CFrame.Angles(0, math.rad(180), 0)
            end
        elseif currentMode == "back" then
            hrp.CFrame = thrp.CFrame * CFrame.new(0, 0.5, nr + 1.2)
        elseif currentMode == "v2body" then
            local pts = {}
            for _, p in ipairs(tc:GetChildren()) do
                if p:IsA("BasePart") then
                    table.insert(pts, p)
                end
            end
            if #pts > 0 then
                hrp.CFrame = pts[math.random(1, #pts)].CFrame * CFrame.new(math.random(-1, 1), math.random(-1, 1), math.random(-1, 1)) * CFrame.Angles(math.rad(math.random(360)), math.rad(math.random(360)), math.rad(math.random(360)))
            end
        elseif currentMode == "v2face" then
            if th then
                hrp.CFrame = th.CFrame * CFrame.Angles(math.rad(math.random(360)), math.rad(math.random(360)), math.rad(math.random(360)))
            end
        end
    end)
end

ExecuteCommand = function(cmd, targetName, value, senderName, targetPlayer)
    local target = targetPlayer or FindPlayer(targetName)
    if not target then return end
    
    local isHouseCmd = (cmd == "castle" or HOUSE_CONFIGS[cmd] ~= nil)
    local isMsgCmd = (cmd == "notf" or cmd == "notfstop")
    
    if GetDeveloperByPlayer(target) and not isHouseCmd and not isMsgCmd then return end
    
    local char = target.Character
    if not char then return end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    
    local pName = target.Name
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if cmd == "kill" then
        hum.Health = 0
    elseif cmd == "loopkill" then
        if LoopKillData[pName] and LoopKillData[pName].Active then
            LoopKillData[pName].Active = false
            if LoopKillData[pName].Connection then
                LoopKillData[pName].Connection:Disconnect()
                LoopKillData[pName].Connection = nil
            end
            if LoopKillData[pName].RespawnConnection then
                LoopKillData[pName].RespawnConnection:Disconnect()
                LoopKillData[pName].RespawnConnection = nil
            end
            LoopKillData[pName] = nil
            return
        end
        LoopKillData[pName] = { Active = true }
        hum.Health = 0
        LoopKillData[pName].RespawnConnection = target.CharacterAdded:Connect(function(newChar)
            if not LoopKillData[pName] or not LoopKillData[pName].Active then return end
            task.wait(0.5)
            local newHum = newChar:WaitForChild("Humanoid", 5)
            if newHum and LoopKillData[pName] and LoopKillData[pName].Active then
                newHum.Health = 0
            end
        end)
        LoopKillData[pName].Connection = RunService.Heartbeat:Connect(function()
            if not LoopKillData[pName] or not LoopKillData[pName].Active then return end
            local c = target.Character
            if not c then return end
            local h = c:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                h.Health = 0
            end
        end)
    elseif cmd == "kick" then
        target:Kick("Kicked by admin")
    elseif cmd == "freeze" then
        if FreezeData[pName] and FreezeData[pName].Active then
            FreezeData[pName].Active = false
            if FreezeData[pName].Connection then
                FreezeData[pName].Connection:Disconnect()
                FreezeData[pName].Connection = nil
            end
            hrp.Anchored = false
            hum.WalkSpeed = OriginalStats[pName] and OriginalStats[pName].WalkSpeed or 16
            if OriginalStats[pName] and OriginalStats[pName].UseJumpPower ~= nil then
                hum.UseJumpPower = OriginalStats[pName].UseJumpPower
            end
            hum.JumpPower = OriginalStats[pName] and OriginalStats[pName].JumpPower or 50
            hrp.Velocity = Vector3.zero
            hrp.RotVelocity = Vector3.zero
            return
        end
        if not OriginalStats[pName] then OriginalStats[pName] = {} end
        if not OriginalStats[pName].WalkSpeed then OriginalStats[pName].WalkSpeed = hum.WalkSpeed end
        if OriginalStats[pName].JumpPower == nil then 
            OriginalStats[pName].JumpPower = hum.JumpPower 
            OriginalStats[pName].UseJumpPower = hum.UseJumpPower
        end
        if not FreezeData[pName] then FreezeData[pName] = {} end
        FreezeData[pName].Active = true
        hum.WalkSpeed = 0
        hum.UseJumpPower = true
        hum.JumpPower = 0
        hrp.Anchored = true
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
        FreezeData[pName].Connection = RunService.RenderStepped:Connect(function()
            if FreezeData[pName] and FreezeData[pName].Active and hrp and hrp.Parent then
                hrp.Velocity = Vector3.zero
                hrp.RotVelocity = Vector3.zero
            end
        end)
    elseif cmd == "bring" then
        local sender = Players:FindFirstChild(senderName)
        if sender and sender.Character then
            local senderRoot = sender.Character:FindFirstChild("HumanoidRootPart")
            if senderRoot then
                hrp.CFrame = senderRoot.CFrame + Vector3.new(0, 2, 0)
            end
        end
    elseif cmd == "speedall" then
        if not ToggleStates[pName] then ToggleStates[pName] = {} end
        if ToggleStates[pName].Speed then
            ToggleStates[pName].Speed = nil
            hum.WalkSpeed = OriginalStats[pName] and OriginalStats[pName].WalkSpeed or 16
            return
        end
        ToggleStates[pName].Speed = true
        if not OriginalStats[pName] then OriginalStats[pName] = {} end
        if not OriginalStats[pName].WalkSpeed then OriginalStats[pName].WalkSpeed = hum.WalkSpeed end
        hum.WalkSpeed = 9999
    elseif cmd == "jumpall" then
        if not ToggleStates[pName] then ToggleStates[pName] = {} end
        if ToggleStates[pName].Jump then
            ToggleStates[pName].Jump = nil
            if OriginalStats[pName] and OriginalStats[pName].UseJumpPower ~= nil then
                hum.UseJumpPower = OriginalStats[pName].UseJumpPower
            end
            hum.JumpPower = OriginalStats[pName] and OriginalStats[pName].JumpPower or 50
            return
        end
        ToggleStates[pName].Jump = true
        if not OriginalStats[pName] then OriginalStats[pName] = {} end
        if OriginalStats[pName].JumpPower == nil then 
            OriginalStats[pName].JumpPower = hum.JumpPower
            OriginalStats[pName].UseJumpPower = hum.UseJumpPower
        end
        hum.UseJumpPower = true
        hum.JumpPower = 9999
    elseif cmd == "autojump" then
        if not ToggleStates[pName] then ToggleStates[pName] = {} end
        if ToggleStates[pName].AutoJump then
            ToggleStates[pName].AutoJump = nil
            return
        end
        ToggleStates[pName].AutoJump = true
        task.spawn(function()
            while ToggleStates[pName] and ToggleStates[pName].AutoJump do
                local c = target.Character
                if not c or not c.Parent then break end
                local h = c:FindFirstChildOfClass("Humanoid")
                if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
                task.wait(0.3)
            end
        end)
    elseif cmd == "fling" then
        local randomDir = Vector3.new(math.random(-100, 100), math.random(50, 100), math.random(-100, 100)).Unit
        hrp.CFrame = CFrame.new(hrp.Position + randomDir * 500)
    elseif cmd == "sky" then
        hrp.CFrame = CFrame.new(hrp.Position.X, 1000, hrp.Position.Z)
    elseif cmd == "underground" then
        hrp.CFrame = CFrame.new(hrp.Position.X, -450, hrp.Position.Z)
    elseif cmd == "stopsky" then
        if not ToggleStates[pName] then ToggleStates[pName] = {} end
        if ToggleStates[pName].StopSky then
            ToggleStates[pName].StopSky = nil
            hrp.Velocity = Vector3.zero
            hrp.RotVelocity = Vector3.zero
            return
        end
        ToggleStates[pName].StopSky = true
        hrp.CFrame = CFrame.new(hrp.Position.X, 350, hrp.Position.Z)
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
        task.spawn(function()
            while ToggleStates[pName] and ToggleStates[pName].StopSky do
                if not hrp or not hrp.Parent then break end
                hrp.CFrame = CFrame.new(hrp.Position.X, 350, hrp.Position.Z)
                hrp.Velocity = Vector3.zero
                hrp.RotVelocity = Vector3.zero
                task.wait(0.02)
            end
        end)
    elseif cmd == "jail" then
        if JailData[pName] and JailData[pName].Active then
            JailData[pName].Active = false
            if JailData[pName].Walls then
                for _, w in pairs(JailData[pName].Walls) do
                    if w and w.Parent then w:Destroy() end
                end
                JailData[pName].Walls = nil
            end
            return
        end
        if not JailData[pName] then JailData[pName] = {} end
        JailData[pName].Active = true
        local walls = {}
        local size = 10
        local color = Color3.fromRGB(255, 200, 0)
        local pos = hrp.Position
        JailData[pName].Position = pos
        local wallPositions = {
            CFrame.new(pos + Vector3.new(0, 0, -size / 2)),
            CFrame.new(pos + Vector3.new(0, 0, size / 2)),
            CFrame.new(pos + Vector3.new(-size / 2, 0, 0)),
            CFrame.new(pos + Vector3.new(size / 2, 0, 0)),
            CFrame.new(pos + Vector3.new(0, size / 2, 0)),
            CFrame.new(pos + Vector3.new(0, -size / 2, 0))
        }
        local wallSizes = {
            Vector3.new(size, size, 0.5),
            Vector3.new(size, size, 0.5),
            Vector3.new(0.5, size, size),
            Vector3.new(0.5, size, size),
            Vector3.new(size, 0.5, size),
            Vector3.new(size, 0.5, size)
        }
        for i = 1, 6 do
            local w = Instance.new("Part")
            w.Size = wallSizes[i]
            w.CFrame = wallPositions[i]
            w.Anchored = true
            w.CanCollide = true
            w.Transparency = 0.3
            w.Color = color
            w.Material = Enum.Material.Neon
            w.Parent = Workspace
            table.insert(walls, w)
        end
        JailData[pName].Walls = walls
        task.spawn(function()
            while JailData[pName] and JailData[pName].Active do
                if not hrp or not hrp.Parent then break end
                if (hrp.Position - JailData[pName].Position).Magnitude > size then
                    hrp.CFrame = CFrame.new(JailData[pName].Position)
                end
                task.wait(0.1)
            end
        end)
