        ToggleStates[pName].StopSky = true
        hrp.CFrame = CFrame.new(hrp.Position.X, 350, hrp.Position.Z)
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
        task.spawn(function()
            while ToggleStates[pName] and ToggleStates[pName].StopSky do
                if not hrp or not hrp.Parent then break end
                hrp.CFrame = CFrame.new(hrp.Position.X, 350, hrp.Position.Z)
                hrp.Velocity = Vector3.zero
                hrp.RotVelocity = Vector3.zero
                task.wait(0.02)
            end
        end)
    elseif cmd == "jail" then
        local size = 10
        if JailData[pName] and JailData[pName].Active then
            JailData[pName].Active = false
            if JailData[pName].Walls then
                for _, w in pairs(JailData[pName].Walls) do
                    if w and w.Parent then w:Destroy() end
                end
                JailData[pName].Walls = nil
            end
            if JailData[pName].RespawnConn then
                pcall(function() JailData[pName].RespawnConn:Disconnect() end)
                JailData[pName].RespawnConn = nil
            end
            JailData[pName] = nil
            return
        end

        local jailPos = hrp and hrp.Position or (target.Character and target.Character:FindFirstChild("HumanoidRootPart") and target.Character.HumanoidRootPart.Position) or Vector3.new(0,10,0)
        
        if not JailData[pName] then JailData[pName] = {} end
        JailData[pName].Active = true
        JailData[pName].Position = jailPos
        JailData[pName].Size = size

        local function buildWallsAt(pos)
            if JailData[pName].Walls then
                for _, w in pairs(JailData[pName].Walls) do
                    if w and w.Parent then w:Destroy() end
                end
            end
            local walls = {}
            local wallPositions = {
                CFrame.new(pos + Vector3.new(0, 0, -size / 2)),
                CFrame.new(pos + Vector3.new(0, 0, size / 2)),
                CFrame.new(pos + Vector3.new(-size / 2, 0, 0)),
                CFrame.new(pos + Vector3.new(size / 2, 0, 0)),
                CFrame.new(pos + Vector3.new(0, size / 2, 0)),
                CFrame.new(pos + Vector3.new(0, -size / 2, 0))
            }
            local wallSizes = {
                Vector3.new(size, size, 0.5), Vector3.new(size, size, 0.5),
                Vector3.new(0.5, size, size), Vector3.new(0.5, size, size),
                Vector3.new(size, 0.5, size), Vector3.new(size, 0.5, size)
            }
            for i = 1, 6 do
                local w = Instance.new("Part")
                w.Name = "JailWall_"..pName.."_"..i
                w.Size = wallSizes[i]
                w.CFrame = wallPositions[i]
                w.Anchored = true
                w.CanCollide = true
                w.Transparency = 0.3
                w.Color = PURPLE
                w.Material = Enum.Material.Neon
                w.Parent = Workspace
                table.insert(walls, w)
            end
            JailData[pName].Walls = walls
        end

        buildWallsAt(jailPos)

        if JailData[pName].RespawnConn then
            pcall(function() JailData[pName].RespawnConn:Disconnect() end)
        end
        JailData[pName].RespawnConn = target.CharacterAdded:Connect(function(newChar)
