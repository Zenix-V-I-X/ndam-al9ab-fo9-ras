        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local root = char:WaitForChild("HumanoidRootPart")

        local snd = Instance.new("Sound")
        snd.Name = "ZenixSound"
        snd.SoundId = SOUND_ID
        snd.Volume = 5
        snd.Looped = true
        snd.Parent = PlayerGui
        snd:Play()
        track(snd)

        addParticles(root, 12, 100, 15)
        addDecal(root, "PLAYERDECAL")

        task.wait(1)
        if not isRunning() then return end

        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("Sky") then v:Destroy() end
        end
        local cs = Instance.new("Sky", Lighting)
        cs.SkyboxBk = CREEPY_SKY
        cs.SkyboxDn = CREEPY_SKY
        cs.SkyboxFt = CREEPY_SKY
        cs.SkyboxLf = CREEPY_SKY
        cs.SkyboxRt = CREEPY_SKY
        cs.SkyboxUp = CREEPY_SKY
        track(cs)

        local ss = Instance.new("Sky", Lighting)
        track(ss)
        task.spawn(function()
            local i = 1
            while isRunning() and ss.Parent do
                local img = SPOOKY_SKY[i]
                ss.SkyboxBk = img
                ss.SkyboxDn = img
                ss.SkyboxFt = img
                ss.SkyboxLf = img
                ss.SkyboxRt = img
                ss.SkyboxUp = img
                i = i + 1
                if i > #SPOOKY_SKY then i = 1 end
                task.wait(0.15)
            end
        end)

        local validParts = {}
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local m = obj:FindFirstAncestorOfClass("Model")
                local isChar = m and m:FindFirstChildOfClass("Humanoid")
                if not isChar and obj.Position.Y > -90 then
                    table.insert(validParts, obj)
                end
            end
        end

        local totalParts = #validParts
        local partsPerSecond = math.ceil(totalParts / 4)

        for second = 1, 4 do
            task.wait(1)
            if not isRunning() then return end
            local startIdx = (second - 1) * partsPerSecond + 1
            local endIdx = math.min(second * partsPerSecond, totalParts)
            for i = startIdx, endIdx do
                if not isRunning() then return end
                local part = validParts[i]
                if part and part.Parent then
                    addDecal(part)
                    addParticles(part, 7, 60, 9)
                end
            end
        end

        local planetFolder = Instance.new("Folder")
        planetFolder.Name = "ZenixPlanets"
        planetFolder.Parent = Workspace
        track(planetFolder)

        local planets = {}
        local planetSizes = 6
        for second = 1, 3 do
            task.wait(1)
            if not isRunning() then return end
            local batchCount = (second == 3) and 8 or 6
            for i = 1, batchCount do
                if not isRunning() then break end
                if #planets >= 20 then break end

                local p = Instance.new("Part")
                p.Shape = Enum.PartType.Ball
                p.Material = Enum.Material.Neon
                local baseSize = math.random(4, 12) * planetSizes
                p.Size = Vector3.new(baseSize, baseSize, baseSize)
                p.Anchored = true
                p.CanCollide = false
                p.TopSurface = Enum.SurfaceType.Smooth
                p.BottomSurface = Enum.SurfaceType.Smooth
                p.Color = RED
                p.Name = "RedPlanet_" .. (#planets + 1)

                local ang = math.random() * math.pi * 2
                local rad = math.random(60, 400)
                local skyY = math.random(150, 400)
                p.Position = Vector3.new(
                    root.Position.X + math.cos(ang) * rad,
                    root.Position.Y + skyY,
                    root.Position.Z + math.sin(ang) * rad
                )
                p.Parent = planetFolder
                addDecal(p, "PLANETDECAL")
                addParticles(p, 22, 120, 22)
                table.insert(planets, {
                    part = p,
                    radius = rad,
                    angle = ang,
                    baseY = skyY,
                    speed = math.random(30, 80) / 100,
                    verticalSpeed = math.random(20, 60) / 100,
                })
            end
        end

        task.spawn(function()
            local t = 0
            while isRunning() and planetFolder.Parent do
                local dt = RunService.Heartbeat:Wait()
                t += dt
                for _, p in ipairs(planets) do
                    p.angle += dt * p.speed
                    local yFloat = math.sin(t * p.verticalSpeed * 3) * 40
                    p.part.CFrame = CFrame.new(
                        root.Position.X + math.cos(p.angle) * p.radius,
                        root.Position.Y + p.baseY + yFloat,
                        root.Position.Z + math.sin(p.angle) * p.radius
                    )
                end
            end
        end)

        local statueFolder = Instance.new("Folder")
        statueFolder.Name = "ZenixStatues"
        statueFolder.Parent = Workspace
        track(statueFolder)

        local SCALE = 4 * 9
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {statueFolder, planetFolder}

        local function getGroundY(x, z)
            local res = Workspace:Raycast(Vector3.new(x, 500, z), Vector3.new(0, -1000, 0), rayParams)
            return res and res.Position.Y or 0
        end

        local function makePart(name, size, isBall)
            local p = Instance.new("Part")
            p.Name = name
            p.Size = size
            p.Anchored = false
            p.CanCollide = true
            p.Material = Enum.Material.Neon
            p.Color = RED
            p.TopSurface = Enum.SurfaceType.Smooth
            p.BottomSurface = Enum.SurfaceType.Smooth
            if isBall then p.Shape = Enum.PartType.Ball end
            addDecal(p, "STATUEDECAL")
            addParticles(p, 14, 130, 22)
            addRealFire(p, 25, 30)
            return p
        end

        local statues = {}
        local usedPositions = {}

        local function farEnough(pos, minDist)
            minDist = minDist or 80
            for _, u in ipairs(usedPositions) do
                if (u - pos).Magnitude < minDist then return false end
            end
            return true
        end

        local function createStatueAt(pos)
            local folder = Instance.new("Folder")
            folder.Name = "RedStatue_" .. (#statues + 1)
            folder.Parent = statueFolder

            local groundY = getGroundY(pos.X, pos.Z)
            local rootPart = Instance.new("Part")
            rootPart.Name = "HumanoidRootPart"
            rootPart.Size = Vector3.new(2*SCALE, 2*SCALE, 1*SCALE)
            rootPart.Anchored = true
            rootPart.CanCollide = false
            rootPart.Transparency = 1
            rootPart.CFrame = CFrame.new(pos.X, groundY + 4*SCALE, pos.Z)
            rootPart.Parent = folder

            local torso = makePart("Torso", Vector3.new(2*SCALE, 2*SCALE, 1*SCALE), false)
            local head  = makePart("Head",  Vector3.new(1.6*SCALE, 1.6*SCALE, 1.6*SCALE), true)
            local larm  = makePart("LArm",  Vector3.new(1*SCALE, 2.2*SCALE, 1*SCALE), false)
            local rarm  = makePart("RArm",  Vector3.new(1*SCALE, 2.2*SCALE, 1*SCALE), false)
            local lleg  = makePart("LLeg",  Vector3.new(1.1*SCALE, 2.2*SCALE, 1.1*SCALE), false)
            local rleg  = makePart("RLeg",  Vector3.new(1.1*SCALE, 2.2*SCALE, 1.1*SCALE), false)
            torso.Parent = folder
            head.Parent = folder
            larm.Parent = folder
            rarm.Parent = folder
            lleg.Parent = folder
            rleg.Parent = folder

            local function motor(name, p0, p1, c0, c1)
                local m = Instance.new("Motor6D")
                m.Name = name
                m.Part0 = p0
                m.Part1 = p1
                m.C0 = c0
                m.C1 = c1
                m.Parent = p0
                return m
            end
            motor("RootJoint", rootPart, torso, CFrame.new(), CFrame.new())
            motor("Neck", torso, head, CFrame.new(0, 1.3*SCALE, 0), CFrame.new(0, -0.8*SCALE, 0))
            local ls = motor("LeftShoulder", torso, larm, CFrame.new(-1.5*SCALE, 0.6*SCALE, 0), CFrame.new(0, 1.1*SCALE, 0))
            local rs = motor("RightShoulder", torso, rarm, CFrame.new(1.5*SCALE, 0.6*SCALE, 0), CFrame.new(0, 1.1*SCALE, 0))
            local lh = motor("LeftHip", torso, lleg, CFrame.new(-0.6*SCALE, -1*SCALE, 0), CFrame.new(0, 1.1*SCALE, 0))
            local rh = motor("RightHip", torso, rleg, CFrame.new(0.6*SCALE, -1*SCALE, 0), CFrame.new(0, 1.1*SCALE, 0))

            table.insert(statues, {
                folder = folder, root = rootPart,
                ls = ls, rs = rs, lh = lh, rh = rh,
                origLs = ls.C0, origRs = rs.C0, origLh = lh.C0, origRh = rh.C0,
                position = Vector3.new(pos.X, groundY + 4*SCALE, pos.Z),
                target = Vector3.new(pos.X, groundY + 4*SCALE, pos.Z),
                yaw = 0, walkPhase = 0,
                speed = math.random(50, 100) / 10,
            })
            table.insert(usedPositions, pos)
        end

        for i = 1, 3 do
            if not isRunning() then return end
            local ang = (i - 1) * (math.pi * 2 / 3) + math.random() * 0.5
            local rad = math.random(20, 40)
            local pos = root.Position + Vector3.new(math.cos(ang) * rad, 0, math.sin(ang) * rad)
            createStatueAt(pos)
            task.wait(1)
        end

        for second = 1, 7 do
            task.wait(1)
            if not isRunning() then return end
            for i = 1, (second <= 6 and 1 or 2) do
                if #statues >= 12 then break end
                local startPos
                for _ = 1, 40 do
                    local ang = math.random() * math.pi * 2
                    local rad = math.random(100, 500)
                    local candidate = root.Position + Vector3.new(math.cos(ang) * rad, 0, math.sin(ang) * rad)
                    if farEnough(candidate, 80) then
                        startPos = candidate
                        break
                    end
                end
                if not startPos then
                    startPos = root.Position + Vector3.new(math.random(-500, 500), 0, math.random(-500, 500))
                end
                createStatueAt(startPos)
            end
        end

        local function pickNewTarget(s, all)
            local base = s.position
            for _ = 1, 25 do
                local cand = base + Vector3.new(math.random(-400, 400), 0, math.random(-400, 400))
                local cy = getGroundY(cand.X, cand.Z) + 4*SCALE
                cand = Vector3.new(cand.X, cy, cand.Z)
                local ok = true
                for _, other in ipairs(all) do
                    if other ~= s and (other.position - cand).Magnitude < 80 then
                        ok = false
                        break
                    end
                end
                if ok then
                    s.target = cand
                    return
                end
            end
            s.target = base + Vector3.new(math.random(-400, 400), 0, math.random(-400, 400))
            s.target = Vector3.new(s.target.X, getGroundY(s.target.X, s.target.Z) + 4*SCALE, s.target.Z)
        end

        task.spawn(function()
            local t = 0
            while isRunning() and statueFolder.Parent do
                local dt = RunService.Heartbeat:Wait()
                t += dt
                for _, s in ipairs(statues) do
                    local dir = s.target - s.position
                    local dist = dir.Magnitude
                    local walking = dist >= 5
                    if walking then
                        local move = dir.Unit * s.speed * dt * 12
                        s.position += move
                        local tgtYaw = math.atan2(-dir.X, -dir.Z)
                        local diff = tgtYaw - s.yaw
                        while diff > math.pi do diff -= math.pi*2 end
                        while diff < -math.pi do diff += math.pi*2 end
                        s.yaw += diff * math.min(1, dt * 6)
                        s.walkPhase += dt * 14
                    else
                        pickNewTarget(s, statues)
                    end

                    local gy = getGroundY(s.position.X, s.position.Z)
                    s.position = Vector3.new(s.position.X, gy + 4*SCALE, s.position.Z)

                    s.root.CFrame = CFrame.new(s.position) * CFrame.Angles(0, s.yaw, 0)

                    local legSwing = walking and math.sin(s.walkPhase) * 0.9 or 0
                    local armSwing = walking and -math.sin(s.walkPhase) * 0.9 or 0
                    s.lh.C0 = s.origLh * CFrame.Angles(legSwing, 0, 0)
                    s.rh.C0 = s.origRh * CFrame.Angles(-legSwing, 0, 0)
                    s.ls.C0 = s.origLs * CFrame.Angles(armSwing, 0, 0)
                    s.rs.C0 = s.origRs * CFrame.Angles(-armSwing, 0, 0)
                end
            end
        end)

        local function makeRed(plr)
            local c = plr.Character
            if not c then return end
            if c:FindFirstChild("ZenixHighlight") then return end
            local h = Instance.new("Highlight")
            h.Name = "ZenixHighlight"
            h.FillColor = RED
            h.OutlineColor = RED
            h.FillTransparency = 0.3
            h.OutlineTransparency = 0
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Parent = c
        end

        for _, plr in ipairs(Players:GetPlayers()) do
            if not isRunning() then break end
            makeRed(plr)
            makeTag(plr)
        end

        Players.PlayerAdded:Connect(function(plr)
            plr.CharacterAdded:Connect(function()
                task.wait(0.5)
                if isRunning() then
                    makeRed(plr)
                    makeTag(plr)
                end
            end)
            if plr.Character then
                makeRed(plr)
                makeTag(plr)
            end
        end)

        local fireFolder = Instance.new("Folder")
        fireFolder.Name = "ZenixFireTrail"
        fireFolder.Parent = Workspace
        track(fireFolder)

        local fireRay = RaycastParams.new()
        fireRay.FilterType = Enum.RaycastFilterType.Exclude
        fireRay.FilterDescendantsInstances = {fireFolder, statueFolder, planetFolder}

        local lastPositions = {}

        task.spawn(function()
            while isRunning() and fireFolder.Parent do
                RunService.Heartbeat:Wait()
                for _, plr in ipairs(Players:GetPlayers()) do
                    local c = plr.Character
                    local r = c and c:FindFirstChild("HumanoidRootPart")
                    if r then
                        local pos = r.Position
                        local last = lastPositions[plr] or Vector3.new(0,0,0)
                        if (pos - last).Magnitude > 2 then
                            lastPositions[plr] = pos
                            local res = Workspace:Raycast(pos + Vector3.new(0,5,0), Vector3.new(0,-30,0), fireRay)
                            if res then
                                local firePart = Instance.new("Part")
                                firePart.Size = Vector3.new(5, 0.3, 5)
                                firePart.Anchored = true
                                firePart.CanCollide = false
                                firePart.Material = Enum.Material.Neon
                                firePart.Color = RED
                                firePart.Transparency = 0.3
                                firePart.CFrame = CFrame.new(res.Position + Vector3.new(0, 0.15, 0))
                                firePart.Parent = fireFolder
                                addDecal(firePart, "FIREDECAL")
                                addRealFire(firePart, 30, 40)
                                task.delay(5, function()
                                    if firePart then firePart:Destroy() end
                                end)
                            end
                        end
                    end
                end
            end
        end)

        local overlay = Instance.new("Frame")
        overlay.Name = "ZenixOverlay"
        overlay.Size = UDim2.new(1, 0, 1, 0)
        overlay.BackgroundColor3 = RED
        overlay.BackgroundTransparency = 0.75
        overlay.BorderSizePixel = 0
        overlay.ZIndex = 5
        overlay.Parent = ScreenGui
        track(overlay)

        task.spawn(function()
            local up = true
            while isRunning() and overlay.Parent do
                local t = overlay.BackgroundTransparency
                overlay.BackgroundTransparency = up and t - 0.008 or t + 0.008
                if overlay.BackgroundTransparency <= 0.6 then up = false end
                if overlay.BackgroundTransparency >= 0.85 then up = true end
                task.wait(0.08)
            end
        end)

        local haloFrame = Instance.new("Frame")
        haloFrame.Name = "FireHalo"
        haloFrame.Size = UDim2.new(0, 10000, 0, 10000)
        haloFrame.Position = UDim2.new(0.5, -5000, 0.5, -5000)
        haloFrame.BackgroundTransparency = 1
        haloFrame.ZIndex = 6
        haloFrame.Parent = ScreenGui
        track(haloFrame)

        local haloImages = {}
        for i = 1, 39 do
            if not isRunning() then break end
            local haloImg = Instance.new("ImageLabel")
            haloImg.Size = UDim2.new(1, 0, 1, 0)
            haloImg.Position = UDim2.new(0, 0, 0, 0)
            haloImg.BackgroundTransparency = 1
            haloImg.Image = "rbxassetid://16454842562"
            haloImg.ImageColor3 = RED
            haloImg.ImageTransparency = 0.3
            haloImg.ZIndex = 6
            haloImg.Rotation = (i - 1) * (360 / 39)
            haloImg.Parent = haloFrame
            table.insert(haloImages, haloImg)
        end

        task.spawn(function()
            local t = 0
            while isRunning() and haloFrame.Parent do
                local dt = RunService.Heartbeat:Wait()
                t += dt
                for i, img in ipairs(haloImages) do
                    img.Rotation = ((i - 1) * (360 / 39)) + t * 30
                    img.ImageTransparency = 0.2 + math.abs(math.sin(t * 2 + i)) * 0.4
                end
            end
        end)

        local logoHalo = Instance.new("ImageLabel")
        logoHalo.Size = UDim2.new(0, 300, 0, 300)
        logoHalo.Position = UDim2.new(0.5, -150, 0.5, -150)
        logoHalo.BackgroundTransparency = 1
        logoHalo.Image = USER_IMAGE
        logoHalo.ImageColor3 = RED
        logoHalo.ImageTransparency = 0.6
        logoHalo.ZIndex = 7
        logoHalo.Parent = ScreenGui
        track(logoHalo)

        task.spawn(function()
            local t = 0
            while isRunning() and logoHalo.Parent do
                local dt = RunService.Heartbeat:Wait()
                t += dt
                local s = 1 + math.sin(t * 2) * 0.2
                logoHalo.Size = UDim2.new(0, 300 * s, 0, 300 * s)
                logoHalo.Position = UDim2.new(0.5, -150 * s, 0.5, -150 * s)
                logoHalo.Rotation = t * 20
            end
        end)

        for i = 1, 9 do
            if not isRunning() then break end
            local jGui = Instance.new("ScreenGui")
            jGui.ResetOnSpawn = false
            jGui.Parent = PlayerGui
            track(jGui)

            local img = Instance.new("ImageLabel")
            img.Size = UDim2.new(1, 0, 1, 0)
            img.BackgroundTransparency = 1
            img.Image = USER_IMAGE
            img.Parent = jGui

            local js = Instance.new("Sound")
            js.SoundId = SOUND_ID
            js.Volume = 2
            js.Looped = true
            js.Parent = jGui
            js:Play()
            track(js)

            task.delay(6, function()
                jGui.Enabled = false
            end)
        end

        for i = 1, 9 do
            if not isRunning() then break end
            local h = Instance.new("Hint")
            h.Text = MSG_TEXT .. " #" .. i
            h.Parent = Workspace
            track(h)
        end

        local msg = Instance.new("TextLabel")
        msg.Size = UDim2.new(1, 0, 1, 0)
        msg.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
        msg.BackgroundTransparency = 0.2
        msg.Text = MSG_TEXT
        msg.TextColor3 = Color3.new(1,1,1)
        msg.TextScaled = true
        msg.Font = Enum.Font.GothamBold
        msg.ZIndex = 999
        msg.Parent = ScreenGui
        track(msg)
        task.delay(7, function()
            msg.Visible = false
        end)
    end

    FireBtn.MouseButton1Click:Connect(function()
        if DarkWebState.Active then fireAllEffects() end
    end)
    DeleteBtn.MouseButton1Click:Connect(StopDarkWeb)
    task.spawn(fireAllEffects)
