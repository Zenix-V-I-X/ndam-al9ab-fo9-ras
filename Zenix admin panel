local function LoadAsset(id, parent, name)
    local success, result = pcall(function()
        local objs = game:GetObjects("rbxassetid://" .. id)
        local container = Instance.new("Folder")
        container.Name = name or "Asset_" .. id
        for _, obj in ipairs(objs) do obj.Parent = container end
        container.Parent = parent
        return container
    end)
    if not success then return nil end
    return result
end

local function BuildCastleFor(Player)
    local pName = Player.Name
    if CastleData[pName] then return end
    local folder = LoadAsset(CASTLE_ASSET_ID, Workspace, "Castle_" .. pName)
    if not folder then return end
    local model = Instance.new("Model")
    model.Name = "Castle_" .. pName
    for _, obj in ipairs(folder:GetChildren()) do obj.Parent = model end
    folder:Destroy()
    model.Parent = Workspace
    local primaryPart = model.PrimaryPart
    if not primaryPart then
        for _, obj in ipairs(model:GetDescendants()) do
            if obj:IsA("BasePart") then primaryPart = obj; model.PrimaryPart = primaryPart; break end
        end
    end
    if not primaryPart then model:Destroy(); return end
    model:SetPrimaryPartCFrame(CFrame.new(CASTLE_POSITION))
    local char = Player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = CFrame.new(CASTLE_POSITION + Vector3.new(0, 3, 0))
    end
    CastleData[pName] = { Model = model }
end

