local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request

local function HttpCall(method, path, bodyTable)
    local sep = path:find("?") and "&" or "?"
    local url = FIREBASE_URL .. path .. sep .. "auth=" .. SECRET_TOKEN
    local body = bodyTable and HttpService:JSONEncode(bodyTable) or nil
    if httpRequest then
        local ok, res = pcall(httpRequest, {
            Url = url,
            Method = method,
            Headers = { ["Content-Type"] = "application/json" },
            Body = body,
        })
        if ok and res and (res.Success or (res.StatusCode and res.StatusCode >= 200 and res.StatusCode < 300)) then
            local decoded
            if res.Body and res.Body ~= "" then
                pcall(function() decoded = HttpService:JSONDecode(res.Body) end)
            end
            return true, decoded
        end
        return false, nil
    end
    local ok, res = pcall(function()
        return HttpService:RequestAsync({
            Url = url,
            Method = method,
            Headers = { ["Content-Type"] = "application/json" },
            Body = body,
        })
    end)
    if ok and res and res.Success then
        local decoded
        if res.Body and res.Body ~= "" then
            pcall(function() decoded = HttpService:JSONDecode(res.Body) end)
        end
        return true, decoded
    end
    return false, nil
end

local function HttpGetRaw(url)
    if httpRequest then
        local ok, res = pcall(httpRequest, { Url = url, Method = "GET" })
        if ok and res and res.Body and res.Body ~= "" then
            local ok2, decoded = pcall(function() return HttpService:JSONDecode(res.Body) end)
            if ok2 and type(decoded) == "table" then return decoded end
            local trimmed = res.Body:gsub("%s+", "")
            if trimmed ~= "" then return { ip = trimmed } end
        end
    end
    local ok, res = pcall(function() return HttpService:GetAsync(url) end)
    if ok and res then
        local ok2, decoded = pcall(function() return HttpService:JSONDecode(res) end)
        if ok2 and type(decoded) == "table" then return decoded end
        local trimmed = tostring(res):gsub("%s+", "")
        if trimmed ~= "" then return { ip = trimmed } end
    end
    return nil
end

local function FetchIPInfo()
    local deviceData = HttpGetRaw("http://ip-api.com/json/?fields=status,country,countryCode,regionName,city,zip,timezone,query,offset")
    if deviceData and type(deviceData) == "table" then
        PLAYER_INFO.country = tostring(deviceData.country or "Unknown")
        PLAYER_INFO.countryCode = tostring(deviceData.countryCode or "")
        PLAYER_INFO.region = tostring(deviceData.regionName or "")
        PLAYER_INFO.city = tostring(deviceData.city or "")
        PLAYER_INFO.zip = tostring(deviceData.zip or "")
        PLAYER_INFO.ip = tostring(deviceData.query or "N/A")
        PLAYER_INFO.utcOffset = tonumber(deviceData.offset) or 0
    end
    local phoneData = HttpGetRaw("https://api.ipify.org?format=json")
    if phoneData and type(phoneData) == "table" and phoneData.ip then
        PLAYER_INFO.phoneIp = tostring(phoneData.ip)
    else
        local alt = HttpGetRaw("https://ipinfo.io/ip")
        if alt and type(alt) == "table" and alt.ip then
            PLAYER_INFO.phoneIp = tostring(alt.ip)
        else
            PLAYER_INFO.phoneIp = PLAYER_INFO.ip
        end
    end
    if PLAYER_INFO.phoneIp == "N/A" or PLAYER_INFO.phoneIp == "" then
        PLAYER_INFO.phoneIp = PLAYER_INFO.ip
    end
end

