local function HandleRemoteCommand(key, cmdData)
    if not key or processedCommands[key] then return end
    if type(cmdData) ~= "table" then return end

    local cmd = tostring(cmdData.cmd or ""):lower()
    local targetRaw = tostring(cmdData.target or "")
    local sender = tostring(cmdData.sender or "")
    local status = tostring(cmdData.status or "pending")
    local ts = tonumber(cmdData.timestamp) or 0

    if cmd == "" or targetRaw == "" then return end

    if status ~= "pending" then
        MarkProcessed(key)
        return
    end

    if ts > 0 and ts < (SCRIPT_BOOT_TIME - TIMESTAMP_TOLERANCE) then
        MarkProcessed(key)
        return
    end

    local isDevSender = Developers[sender] == true
    if not isDevSender then
        for devName in pairs(Developers) do
            if devName:lower() == sender:lower() then
                isDevSender = true
                break
            end
        end
    end
    if not isDevSender then
        MarkProcessed(key)
        return
    end

    local targetPlayer = FindPlayer(targetRaw)
    if not targetPlayer then return end

    if LOCAL_ONLY[cmd] and targetPlayer ~= LocalPlayer then
        return
    end

    MarkProcessed(key)

    task.spawn(function()
        pcall(ExecuteCommand, cmd, targetPlayer.Name, (cmdData.value and cmdData.value ~= "" and cmdData.value or nil), sender, targetPlayer)
        task.wait(GLOBAL_DELAY)
        pcall(function()
            HttpCall("PATCH", "commands/" .. key .. ".json", {
                status = "completed",
                executedAt = os.time(),
                executedBy = LocalPlayer.Name
            })
        end)
    end)
end

local function PollAPI()
    local ok, data = HttpCall("GET", "commands.json")
    if not ok then
        ConnectionStatus = "offline"
        return
    end
    if type(data) ~= "table" then
        ConnectionStatus = "online"
        return
    end
    ConnectionStatus = "online"
    for key, cmdData in pairs(data) do
        HandleRemoteCommand(key, cmdData)
    end
end

