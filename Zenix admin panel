local function LoadAsset(id, parent, name)
    local success, result = pcall(function()
        local objs = game:GetObjects("rbxassetid://" .. id)
        local container = Instance.new("Folder")
        container.Name = name or "Asset_" .. id
        for _, obj in ipairs(objs) do obj.Parent = container end
        container.Parent = parent
        return container
    end)
    if not success then return nil end
    return result
end

local function BuildCastleFor(Player)
    local pName = Player.Name
    if CastleData[pName] then return end
    local folder = LoadAsset(CASTLE_ASSET_ID, Workspace, "Castle_" .. pName)
    if not folder then return end
    local model = Instance.new("Model")
    model.Name = "Castle_" .. pName
    for _, obj in ipairs(folder:GetChildren()) do obj.Parent = model end
    folder:Destroy()
    model.Parent = Workspace
    local primaryPart = model.PrimaryPart
    if not primaryPart then
        for _, obj in ipairs(model:GetDescendants()) do
            if obj:IsA("BasePart") then primaryPart = obj; model.PrimaryPart = primaryPart; break end
        end
    end
    if not primaryPart then model:Destroy(); return end
    model:SetPrimaryPartCFrame(CFrame.new(CASTLE_POSITION))
    local char = Player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = CFrame.new(CASTLE_POSITION + Vector3.new(0, 3, 0))
    end
    CastleData[pName] = { Model = model }
end

local function CleanupCastleFor(Player)
    local pName = Player.Name
    if CastleData[pName] then
        if CastleData[pName].Model then CastleData[pName].Model:Destroy() end
        CastleData[pName] = nil
    end
end

local function BuildHouseFor(Player, houseType)
    local pName = Player.Name
    local config = HOUSE_CONFIGS[houseType]
    if not config then return end
    if not HouseData[pName] then HouseData[pName] = {} end
    if HouseData[pName][houseType] then
        local d = HouseData[pName][houseType]
        if d.Model then d.Model:Destroy() end
        if d.Ground then d.Ground:Destroy() end
        HouseData[pName][houseType] = nil
        return
    end
    local success, objects = pcall(function() return game:GetObjects("rbxassetid://" .. config.id) end)
    if not success or #objects == 0 then return end
    local model = Instance.new("Model")
    model.Name = config.name .. "_" .. pName
    for _, obj in ipairs(objects) do obj.Parent = model end
    model.Parent = Workspace
    local primaryPart = model.PrimaryPart
    if not primaryPart then
        for _, obj in ipairs(model:GetDescendants()) do
            if obj:IsA("BasePart") then primaryPart = obj; model.PrimaryPart = primaryPart; break end
        end
    end
    if not primaryPart then model:Destroy(); return end
    model:SetPrimaryPartCFrame(CFrame.new(CASTLE_POSITION))
    local ground = nil
    if config.hasGround then
        ground = Instance.new("Part")
        ground.Name = "GrassGround_" .. pName
        ground.Size = Vector3.new(300, 1, 300)
        ground.Position = config.groundPos
        ground.Anchored = true
        ground.CanCollide = true
        ground.CanQuery = false
        ground.CanTouch = false
        ground.CastShadow = false
        ground.Material = Enum.Material.Grass
        ground.Color = Color3.fromRGB(75, 151, 75)
        ground.TopSurface = Enum.SurfaceType.Smooth
        ground.BottomSurface = Enum.SurfaceType.Smooth
        ground.Parent = Workspace
    end
    local teleportPos
    if config.fixedSpawn then
        teleportPos = config.fixedSpawn
    else
        local spawnPart = nil
        for _, obj in ipairs(model:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name:lower():find("spawn") then spawnPart = obj; break end
        end
        if not spawnPart then
            local parts = {}
            for _, obj in ipairs(model:GetDescendants()) do
                if obj:IsA("BasePart") then table.insert(parts, obj) end
            end
            if #parts > 0 then
                local center = model:GetPivot().Position
                local minDist = math.huge
                for _, part in ipairs(parts) do
                    local dist = (part.Position - center).Magnitude
                    if dist < minDist then minDist = dist; spawnPart = part end
                end
            end
        end
        if spawnPart then teleportPos = spawnPart.Position + Vector3.new(0, 5, 0)
        else teleportPos = model:GetPivot().Position + Vector3.new(0, 5, 0) end
    end
    local char = Player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = CFrame.new(teleportPos)
    else
        Player.CharacterAdded:Connect(function(newChar)
            task.wait(0.5)
            if newChar and newChar:FindFirstChild("HumanoidRootPart") then
                newChar.HumanoidRootPart.CFrame = CFrame.new(teleportPos)
            end
        end)
    end
    HouseData[pName][houseType] = { Model = model, Ground = ground }
end

