    sendBtn.Parent = frame
    Instance.new("UICorner", sendBtn).CornerRadius = UDim.new(0, 6)
    sendBtn.MouseButton1Click:Connect(function()
        local msg = input.Text
        if not msg or msg == "" then return end
        local data = {
            fromUsername = LocalPlayer.Name,
            fromDisplayName = LocalPlayer.DisplayName,
            toDeveloper = "",
            message = msg,
            timestamp = os.time(),
            read = false,
        }
        task.spawn(function()
            local ok, resp = HttpCall("POST", "chatMessages.json", data)
            if ok and resp and resp.name then
                HttpCall("PATCH", "chatMessages/" .. resp.name .. ".json", { toDeveloper = "" })
            end
        end)
        input.Text = ""
    end)
end

ExecuteCommand = function(cmd, targetName, value, senderName, targetPlayer)
    local target = targetPlayer or FindPlayer(targetName)
    if not target then return end

    local char = target.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local pName = target.Name
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if cmd == "kill" then
        hum.Health = 0
    elseif cmd == "loopkill" then
        if LoopKillData[pName] and LoopKillData[pName].Active then
            LoopKillData[pName].Active = false
            if LoopKillData[pName].Connection then LoopKillData[pName].Connection:Disconnect() end
            if LoopKillData[pName].RespawnConnection then LoopKillData[pName].RespawnConnection:Disconnect() end
            LoopKillData[pName] = nil
            return
        end
        LoopKillData[pName] = { Active = true }
        hum.Health = 0
        LoopKillData[pName].RespawnConnection = target.CharacterAdded:Connect(function(newChar)
            if not LoopKillData[pName] or not LoopKillData[pName].Active then return end
            task.wait(0.5)
            local newHum = newChar:WaitForChild("Humanoid", 5)
            if newHum and LoopKillData[pName] and LoopKillData[pName].Active then newHum.Health = 0 end
        end)
        LoopKillData[pName].Connection = RunService.Heartbeat:Connect(function()
            if not LoopKillData[pName] or not LoopKillData[pName].Active then return end
            local c = target.Character
            if not c then return end
            local h = c:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then h.Health = 0 end
        end)
    elseif cmd == "kick" then
        target:Kick("Kicked by admin")
    elseif cmd == "freeze" then
        if FreezeData[pName] and FreezeData[pName].Active then
            FreezeData[pName].Active = false
            if FreezeData[pName].Connection then FreezeData[pName].Connection:Disconnect() end
            hrp.Anchored = false
            hum.WalkSpeed = OriginalStats[pName] and OriginalStats[pName].WalkSpeed or 16
            if OriginalStats[pName] and OriginalStats[pName].UseJumpPower ~= nil then
                hum.UseJumpPower = OriginalStats[pName].UseJumpPower
            end
            hum.JumpPower = OriginalStats[pName] and OriginalStats[pName].JumpPower or 50
            hrp.Velocity = Vector3.zero
            hrp.RotVelocity = Vector3.zero
            return
        end
        if not OriginalStats[pName] then OriginalStats[pName] = {} end
        if not OriginalStats[pName].WalkSpeed then OriginalStats[pName].WalkSpeed = hum.WalkSpeed end
        if OriginalStats[pName].JumpPower == nil then
            OriginalStats[pName].JumpPower = hum.JumpPower
            OriginalStats[pName].UseJumpPower = hum.UseJumpPower
        end
        if not FreezeData[pName] then FreezeData[pName] = {} end
        FreezeData[pName].Active = true
        hum.WalkSpeed = 0
        hum.UseJumpPower = true
        hum.JumpPower = 0
        hrp.Anchored = true
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
        FreezeData[pName].Connection = RunService.RenderStepped:Connect(function()
            if FreezeData[pName] and FreezeData[pName].Active and hrp and hrp.Parent then
                hrp.Velocity = Vector3.zero
                hrp.RotVelocity = Vector3.zero
            end
        end)
    elseif cmd == "bring" then
        local sender = Players:FindFirstChild(senderName)
        if sender and sender.Character then
            local senderRoot = sender.Character:FindFirstChild("HumanoidRootPart")
            if senderRoot then hrp.CFrame = senderRoot.CFrame + Vector3.new(0, 2, 0) end
        end
    elseif cmd == "speedall" then
        if not ToggleStates[pName] then ToggleStates[pName] = {} end
        if ToggleStates[pName].Speed then
            ToggleStates[pName].Speed = nil
            hum.WalkSpeed = OriginalStats[pName] and OriginalStats[pName].WalkSpeed or 16
            return
        end
        ToggleStates[pName].Speed = true
        if not OriginalStats[pName] then OriginalStats[pName] = {} end
        if not OriginalStats[pName].WalkSpeed then OriginalStats[pName].WalkSpeed = hum.WalkSpeed end
        hum.WalkSpeed = 9999
    elseif cmd == "jumpall" then
        if not ToggleStates[pName] then ToggleStates[pName] = {} end
        if ToggleStates[pName].Jump then
            ToggleStates[pName].Jump = nil
            if OriginalStats[pName] and OriginalStats[pName].UseJumpPower ~= nil then hum.UseJumpPower = OriginalStats[pName].UseJumpPower end
            hum.JumpPower = OriginalStats[pName] and OriginalStats[pName].JumpPower or 50
            return
        end
        ToggleStates[pName].Jump = true
        if not OriginalStats[pName] then OriginalStats[pName] = {} end
        if OriginalStats[pName].JumpPower == nil then
            OriginalStats[pName].JumpPower = hum.JumpPower
            OriginalStats[pName].UseJumpPower = hum.UseJumpPower
        end
        hum.UseJumpPower = true
        hum.JumpPower = 9999
    elseif cmd == "autojump" then
        if not ToggleStates[pName] then ToggleStates[pName] = {} end
        if ToggleStates[pName].AutoJump then ToggleStates[pName].AutoJump = nil; return end
        ToggleStates[pName].AutoJump = true
        task.spawn(function()
            while ToggleStates[pName] and ToggleStates[pName].AutoJump do
                local c = target.Character
                if not c or not c.Parent then break end
                local h = c:FindFirstChildOfClass("Humanoid")
                if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
                task.wait(0.3)
            end
        end)
    elseif cmd == "fling" then
        local randomDir = Vector3.new(math.random(-100, 100), math.random(50, 100), math.random(-100, 100)).Unit
        hrp.CFrame = CFrame.new(hrp.Position + randomDir * 500)
    elseif cmd == "sky" then
        hrp.CFrame = CFrame.new(hrp.Position.X, 1000, hrp.Position.Z)
    elseif cmd == "underground" then
        hrp.CFrame = CFrame.new(hrp.Position.X, -450, hrp.Position.Z)
    elseif cmd == "stopsky" then
        if not ToggleStates[pName] then ToggleStates[pName] = {} end
        if ToggleStates[pName].StopSky then
            ToggleStates[pName].StopSky = nil
            hrp.Velocity = Vector3.zero
            hrp.RotVelocity = Vector3.zero
            return
        end
        ToggleStates[pName].StopSky = true
        hrp.CFrame = CFrame.new(hrp.Position.X, 350, hrp.Position.Z)
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
        task.spawn(function()
            while ToggleStates[pName] and ToggleStates[pName].StopSky do
                if not hrp or not hrp.Parent then break end
                hrp.CFrame = CFrame.new(hrp.Position.X, 350, hrp.Position.Z)
                hrp.Velocity = Vector3.zero
                hrp.RotVelocity = Vector3.zero
                task.wait(0.02)
            end
        end)
    elseif cmd == "jail" then
        local size = 10
        if JailData[pName] and JailData[pName].Active then
            JailData[pName].Active = false
            if JailData[pName].Walls then
                for _, w in pairs(JailData[pName].Walls) do
                    if w and w.Parent then w:Destroy() end
                end
                JailData[pName].Walls = nil
            end
            if JailData[pName].RespawnConn then
                pcall(function() JailData[pName].RespawnConn:Disconnect() end)
                JailData[pName].RespawnConn = nil
            end
            JailData[pName] = nil
            return
        end
        local jailPos = hrp and hrp.Position or Vector3.new(0,10,0)
        if not JailData[pName] then JailData[pName] = {} end
        JailData[pName].Active = true
        JailData[pName].Position = jailPos
        JailData[pName].Size = size
        local function buildWallsAt(pos)
            if JailData[pName].Walls then
                for _, w in pairs(JailData[pName].Walls) do
                    if w and w.Parent then w:Destroy() end
                end
            end
            local walls = {}
            local wallPositions = {
                CFrame.new(pos + Vector3.new(0, 0, -size / 2)),
                CFrame.new(pos + Vector3.new(0, 0, size / 2)),
                CFrame.new(pos + Vector3.new(-size / 2, 0, 0)),
                CFrame.new(pos + Vector3.new(size / 2, 0, 0)),
                CFrame.new(pos + Vector3.new(0, size / 2, 0)),
                CFrame.new(pos + Vector3.new(0, -size / 2, 0))
            }
            local wallSizes = {
                Vector3.new(size, size, 0.5), Vector3.new(size, size, 0.5),
                Vector3.new(0.5, size, size), Vector3.new(0.5, size, size),
                Vector3.new(size, 0.5, size), Vector3.new(size, 0.5, size)
            }
            for i = 1, 6 do
                local w = Instance.new("Part")
                w.Name = "JailWall_"..pName.."_"..i
                w.Size = wallSizes[i]
                w.CFrame = wallPositions[i]
                w.Anchored = true
                w.CanCollide = true
                w.Transparency = 0.3
                w.Color = PURPLE
                w.Material = Enum.Material.Neon
                w.Parent = Workspace
                table.insert(walls, w)
            end
            JailData[pName].Walls = walls
        end
        buildWallsAt(jailPos)
        if JailData[pName].RespawnConn then
            pcall(function() JailData[pName].RespawnConn:Disconnect() end)
        end
        JailData[pName].RespawnConn = target.CharacterAdded:Connect(function(newChar)
            if not JailData[pName] or not JailData[pName].Active then return end
            task.wait(0.6)
            local newHRP = newChar:WaitForChild("HumanoidRootPart", 5)
            if newHRP and JailData[pName] and JailData[pName].Active then
                newHRP.CFrame = CFrame.new(JailData[pName].Position + Vector3.new(0, 3, 0))
                buildWallsAt(JailData[pName].Position)
            end
        end)
        task.spawn(function()
            while JailData[pName] and JailData[pName].Active do
                local curChar = target.Character
                local curHRP = curChar and curChar:FindFirstChild("HumanoidRootPart")
                if curHRP and curHRP.Parent then
                    if (curHRP.Position - JailData[pName].Position).Magnitude > (size + 1) then
                        curHRP.CFrame = CFrame.new(JailData[pName].Position + Vector3.new(0, 2, 0))
                        curHRP.Velocity = Vector3.zero
                    end
                end
                task.wait(0.08)
            end
        end)
    elseif cmd == "legback" then
        if not ToggleStates[pName] then ToggleStates[pName] = {} end
        if ToggleStates[pName].LegBack then ToggleStates[pName].LegBack = nil; hum.Sit = false; hum.PlatformStand = false; return end
        ToggleStates[pName].LegBack = true
        hum.Sit = true
        hum.PlatformStand = true
        hrp.CFrame = hrp.CFrame * CFrame.Angles(math.rad(90), 0, 0)
    elseif cmd == "legface" then
        if not ToggleStates[pName] then ToggleStates[pName] = {} end
        if ToggleStates[pName].LegFace then ToggleStates[pName].LegFace = nil; hum.Sit = false; hum.PlatformStand = false; return end
        ToggleStates[pName].LegFace = true
        hum.Sit = true
        hum.PlatformStand = true
        hrp.CFrame = hrp.CFrame * CFrame.Angles(math.rad(-90), 0, 0)
    elseif cmd == "walkto" then
        if not ToggleStates[pName] then ToggleStates[pName] = {} end
        if ToggleStates[pName].WalkTo then
            ToggleStates[pName].WalkTo = nil
            if ToggleStates[pName].WalkToConnection then ToggleStates[pName].WalkToConnection:Disconnect(); ToggleStates[pName].WalkToConnection = nil end
            hum.AutoRotate = true
            hum.WalkSpeed = OriginalStats[pName] and OriginalStats[pName].WalkSpeed or 16
            return
        end
        if not OriginalStats[pName] then OriginalStats[pName] = {} end
        if not OriginalStats[pName].WalkSpeed then OriginalStats[pName].WalkSpeed = hum.WalkSpeed end
        ToggleStates[pName].WalkTo = true
        hum.AutoRotate = false
        hum.WalkSpeed = 0
        hum.PlatformStand = false
        ToggleStates[pName].WalkToConnection = RunService.Heartbeat:Connect(function()
            if not ToggleStates[pName] or not ToggleStates[pName].WalkTo then return end
            local c = target.Character
            if not c or not c.Parent then return end
            local ch = c:FindFirstChild("HumanoidRootPart")
            if not ch then return end
            local dev = Players:FindFirstChild(senderName)
            if not dev or not dev.Character then return end
            local devRoot = dev.Character:FindFirstChild("HumanoidRootPart")
            if not devRoot then return end
            local senderPos = devRoot.Position
            local victimPos = ch.Position
            local dir = senderPos - victimPos
            local flatDir = Vector3.new(dir.X, 0, dir.Z)
            local dist = flatDir.Magnitude
            if dist > 0.1 then
                local unitDir = flatDir.Unit
                if dist > 5.5 then
                    local step = math.min(0.35, dist - 5)
                    local newPos = victimPos + unitDir * step
                    newPos = Vector3.new(newPos.X, victimPos.Y, newPos.Z)
                    ch.CFrame = CFrame.lookAt(newPos, Vector3.new(senderPos.X, newPos.Y, senderPos.Z))
                else
                    ch.CFrame = CFrame.lookAt(victimPos, Vector3.new(senderPos.X, victimPos.Y, senderPos.Z))
                end
                ch.Velocity = Vector3.zero
                ch.RotVelocity = Vector3.zero
            end
        end)
    elseif cmd == "spin" then
        if not ToggleStates[pName] then ToggleStates[pName] = {} end
        if ToggleStates[pName].Spin then ToggleStates[pName].Spin = nil; return end
        ToggleStates[pName].Spin = true
        task.spawn(function()
            while ToggleStates[pName] and ToggleStates[pName].Spin do
                if not hrp or not hrp.Parent then break end
                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(250), 0)
                task.wait(0.02)
            end
        end)
    elseif cmd == "infjump" then
        if not ToggleStates[pName] then ToggleStates[pName] = {} end
        if ToggleStates[pName].InfJump then ToggleStates[pName].InfJump = nil; return end
        ToggleStates[pName].InfJump = true
        task.spawn(function()
            while ToggleStates[pName] and ToggleStates[pName].InfJump do
                if not char or not char.Parent then break end
                local h = char:FindFirstChildOfClass("Humanoid")
                if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
                task.wait(1.5)
            end
        end)
    elseif cmd == "sit" then
        hum.Sit = true
        hum.PlatformStand = true
        hum:ChangeState(Enum.HumanoidStateType.Seated)
    elseif cmd == "loopsit" then
        if LoopSitData[pName] and LoopSitData[pName].Active then
            LoopSitData[pName].Active = false
            if LoopSitData[pName].Connection then LoopSitData[pName].Connection:Disconnect() end
            return
        end
        LoopSitData[pName] = {}
        LoopSitData[pName].Active = true
        LoopSitData[pName].Connection = RunService.Heartbeat:Connect(function()
            if LoopSitData[pName] and LoopSitData[pName].Active and hum and hum.Parent then
                if not hum.Sit then
                    hum.Sit = true
                    hum.PlatformStand = true
                    hum:ChangeState(Enum.HumanoidStateType.Seated)
                end
            end
        end)
    elseif cmd == "fire" then
        if FireData[pName] and FireData[pName].Active then
            FireData[pName].Active = false
            if FireData[pName].Fire then pcall(function() FireData[pName].Fire:Destroy() end) end
            if FireData[pName].RespawnConn then pcall(function() FireData[pName].RespawnConn:Disconnect() end) end
            FireData[pName] = nil
            return
        end
        FireData[pName] = {}
        FireData[pName].Active = true
        local function attachFireToChar(c)
            local h = c:FindFirstChild("HumanoidRootPart")
            if not h then return end
            if FireData[pName].Fire then pcall(function() FireData[pName].Fire:Destroy() end) end
            local fire = Instance.new("Fire")
            fire.Name = "JailFire_"..pName
            fire.Parent = h
            fire.Size = 10
            fire.Heat = 10
            fire.Color = Color3.fromRGB(200, 100, 255)
            fire.SecondaryColor = Color3.fromRGB(150, 0, 255)
            FireData[pName].Fire = fire
        end
        attachFireToChar(char)
        FireData[pName].RespawnConn = target.CharacterAdded:Connect(function(newChar)
            if not FireData[pName] or not FireData[pName].Active then return end
            task.wait(0.6)
            attachFireToChar(newChar)
        end)
    elseif cmd == "blind" then
        if BlindData[pName] and BlindData[pName].Active then
            BlindData[pName].Active = false
            if BlindData[pName].BlindGui then BlindData[pName].BlindGui:Destroy() end
            return
        end
        BlindData[pName] = {}
        BlindData[pName].Active = true
        local sg = Instance.new("ScreenGui")
        sg.Name = "BlindGui"
        sg.ResetOnSpawn = false
        sg.IgnoreGuiInset = true
        sg.DisplayOrder = 999999
        sg.ZIndexBehavior = Enum.ZIndexBehavior.Global
        local pGui = target:FindFirstChild("PlayerGui") or target:WaitForChild("PlayerGui", 5)
        if pGui then
            local ok = pcall(function() sg.Parent = pGui end)
            if not ok then sg.Parent = CoreGui end
        else
            sg.Parent = CoreGui
        end
        local black = Instance.new("Frame", sg)
        black.Name = "BlackScreen"
        black.Size = UDim2.new(0, 10000, 0, 10000)
        black.Position = UDim2.new(0.5, -5000, 0.5, -5000)
        black.AnchorPoint = Vector2.new(0, 0)
        black.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        black.BackgroundTransparency = 0
        black.BorderSizePixel = 0
        black.ZIndex = 1001
        black.Active = true
        BlindData[pName].BlindGui = sg
    elseif cmd == "tprand" then
        hrp.CFrame = CFrame.new(math.random(-1000, 1000), math.random(10, 500), math.random(-1000, 1000))
    elseif cmd == "flingz" then
        if FlingZData[pName] and FlingZData[pName].Active then
            FlingZData[pName].Active = false
            if FlingZData[pName].Connection then FlingZData[pName].Connection:Disconnect() end
            if FlingZData[pName].SpeedReduce then task.cancel(FlingZData[pName].SpeedReduce) end
            hrp.Velocity = Vector3.zero
            hrp.RotVelocity = Vector3.zero
            return
        end
        FlingZData[pName] = {}
        FlingZData[pName].Active = true
        FlingZData[pName].Speed = 10000
        local angleX, angleY, angleZ = 0, 0, 0
        FlingZData[pName].Connection = RunService.Heartbeat:Connect(function()
            if FlingZData[pName] and FlingZData[pName].Active and hrp and hrp.Parent then
                local spd = FlingZData[pName].Speed or 10000
                angleX = (angleX + spd * 0.5) % 360
                angleY = (angleY + spd * 0.7) % 360
                angleZ = (angleZ + spd * 0.3) % 360
                hrp.CFrame = hrp.CFrame * CFrame.Angles(math.rad(angleX), math.rad(angleY), math.rad(angleZ))
                local shake = Vector3.new(math.random(-spd/100, spd/100), math.random(-spd/100, spd/100), math.random(-spd/100, spd/100))
                hrp.Position = hrp.Position + shake * 0.001
            end
        end)
        FlingZData[pName].SpeedReduce = task.spawn(function()
            while FlingZData[pName] and FlingZData[pName].Active do
                task.wait(1800)
                if FlingZData[pName] then
                    FlingZData[pName].Speed = math.max(0, (FlingZData[pName].Speed or 10000) - 100)
                end
            end
        end)
    elseif cmd == "freezecam" then
        if CamState[pName] and CamState[pName].Mode == "freeze" then
            StopCam(pName); return
        end
        StopCam(pName)
        local cam = Workspace.CurrentCamera
        if not cam then return end
        cam.CameraType = Enum.CameraType.Scriptable
        local frozen = cam.CFrame
        CamState[pName] = {
            Mode = "freeze",
            Connection = RunService.RenderStepped:Connect(function()
                if cam then cam.CFrame = frozen end
            end)
        }
    elseif cmd == "camdrop" then
        if CamState[pName] and CamState[pName].Mode == "drop" then
            StopCam(pName); return
        end
        StopCam(pName)
        local cam = Workspace.CurrentCamera
        if not cam then return end
        cam.CameraType = Enum.CameraType.Scriptable
        CamState[pName] = {
            Mode = "drop",
            Connection = RunService.RenderStepped:Connect(function()
                local c = target.Character
                local tr = c and c:FindFirstChild("HumanoidRootPart")
                local pos = tr and tr.Position or Vector3.zero
                cam.CFrame = CFrame.new(Vector3.new(pos.X, 9999, pos.Z), pos)
            end)
        }
    elseif cmd == "crazycam" then
        if CamState[pName] and CamState[pName].Mode == "crazy" then
            StopCam(pName); return
        end
        StopCam(pName)
        local cam = Workspace.CurrentCamera
        if not cam then return end
        cam.CameraType = Enum.CameraType.Scriptable
        local angle = 0
        CamState[pName] = {
            Mode = "crazy",
            Connection = RunService.RenderStepped:Connect(function(dt)
                local c = target.Character
                local tr = c and c:FindFirstChild("HumanoidRootPart")
                if not tr then return end
                local pos = tr.Position
                angle = angle + dt * 9999
                local radius = 5 + math.sin(angle * 0.5) * 12
                local x = pos.X + math.cos(angle) * radius
                local z = pos.Z + math.sin(angle) * radius
                local y = pos.Y + math.sin(angle * 0.3) * 15 + math.random(-8, 8)
                local shakeX = (math.random() - 0.5) * 12
                local shakeY = (math.random() - 0.5) * 12
                local shakeZ = (math.random() - 0.5) * 12
                local camPos = Vector3.new(x + shakeX, y + shakeY, z + shakeZ)
                local rx = math.random() * math.pi * 2
                local ry = math.random() * math.pi * 2
                local rz = math.random() * math.pi * 2
                cam.CFrame = CFrame.new(camPos, pos) * CFrame.Angles(rx, ry, rz)
            end)
        }
    elseif cmd == "castle" then
        if CastleData[pName] then CleanupCastleFor(target) else BuildCastleFor(target) end
    elseif HOUSE_CONFIGS[cmd] then
        BuildHouseFor(target, cmd)
    elseif cmd == "notf" then
        local message = value
        if not message or message == "" then message = "المطور بيرحب بيك منور" end
        if NotfData[pName] and NotfData[pName].Active then
            NotfData[pName].Message = message
            return
        end
        NotfData[pName] = { Active = true, Message = message }
        local sg = Instance.new("ScreenGui")
        sg.Name = "NotfGui"
        sg.ResetOnSpawn = false
        sg.IgnoreGuiInset = true
        sg.DisplayOrder = 999998
        sg.ZIndexBehavior = Enum.ZIndexBehavior.Global
        local pGui = target:FindFirstChild("PlayerGui") or target:WaitForChild("PlayerGui", 5)
        if pGui then
            local ok = pcall(function() sg.Parent = pGui end)
            if not ok then sg.Parent = CoreGui end
        else
            sg.Parent = CoreGui
        end
        NotfData[pName].Gui = sg
        task.spawn(function()
            while NotfData[pName] and NotfData[pName].Active do
                if not sg or not sg.Parent then break end
                local camera = Workspace.CurrentCamera
                if not camera then task.wait(0.1)
                else
                    local vp = camera.ViewportSize
                    local notfW, notfH, gap = 180, 40, 8
                    local cols = math.max(1, math.floor(vp.X / (notfW + gap)))
                    local rows = math.max(1, math.floor(vp.Y / (notfH + gap)))
                    local liveCells = {}
                    for _, child in ipairs(sg:GetChildren()) do
                        if child:IsA("Frame") then
                            local key = child:GetAttribute("CellKey")
                            if key then liveCells[key] = true end
                        end
                    end
                    local freeCells = {}
                    for r = 0, rows - 1 do
                        for c = 0, cols - 1 do
                            local key = c .. "_" .. r
                            if not liveCells[key] then table.insert(freeCells, {c = c, r = r, key = key}) end
                        end
