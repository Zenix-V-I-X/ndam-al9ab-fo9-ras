local ExecuteCommand = function(cmd, targetName, value, senderName, targetPlayer)
    local target = targetPlayer or FindPlayer(targetName)
    if not target then return end

    if cmd == "joinserver" then
        if target == LocalPlayer and value then
            local placeId, jobId = tostring(value):match("^(%d+)|(.+)$")
            if placeId and jobId and jobId ~= "" then
                task.wait(0.5)
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(tonumber(placeId), jobId, LocalPlayer)
                end)
            end
        end
        return
    end

    if cmd == "zenixdarkweb" then
        if target == LocalPlayer then
            if DarkWebState.Active then StopDarkWeb() else StartDarkWeb() end
        end
        return
    end

    if cmd == "givechat" then
        if target == LocalPlayer then GiveChatGui(senderName) end
        return
    end

    if cmd == "rainbowmap" then
        if target ~= LocalPlayer then return end
        if RainbowMapData.Active then StopRainbowMap() return end
        RainbowMapData = { Active = true, OriginalColors = {} }
        local count = 0
