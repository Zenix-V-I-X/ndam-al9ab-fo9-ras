local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request

local function HttpCall(method, path, bodyTable)
    local url = FIREBASE_URL .. path
    local body = bodyTable and HttpService:JSONEncode(bodyTable) or nil

    local headers = {
        ["Content-Type"] = "application/json",
        ["Authorization"] = "Bearer " .. SECRET_TOKEN,
    }

    if httpRequest then
        local ok, res = pcall(httpRequest, {
            Url = url,
            Method = method,
            Headers = headers,
            Body = body,
        })
        if ok and res and (res.Success or (res.StatusCode and res.StatusCode >= 200 and res.StatusCode < 300)) then
            local decoded
            if res.Body and res.Body ~= "" then
                pcall(function() decoded = HttpService:JSONDecode(res.Body) end)
            end
            return true, decoded
        end
        return false, nil
    end

    if method == "GET" then
        local ok, res = pcall(function() return HttpService:GetAsync(url, true, headers) end)
        if ok and res then
            local decoded
            pcall(function() decoded = HttpService:JSONDecode(res) end)
            return true, decoded
        end
        return false, nil
    end
    if method == "POST" then
        local ok, res = pcall(function()
            return HttpService:PostAsync(url, body, Enum.HttpContentType.ApplicationJson, false, headers)
        end)
        if ok and res then
            local decoded
            pcall(function() decoded = HttpService:JSONDecode(res) end)
            return true, decoded
        end
    end
    if method == "PATCH" then
        local ok, res = pcall(function()
            return HttpService:RequestAsync({
                Url = url,
                Method = "PATCH",
                Headers = headers,
                Body = body,
            })
        end)
        if ok and res and res.Success then
            local decoded
            pcall(function() decoded = HttpService:JSONDecode(res.Body) end)
            return true, decoded
        end
    end
    return false, nil
end

