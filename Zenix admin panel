            local TabStroke = Instance.new("UIStroke", TabBtn)
            TabStroke.Thickness = 2.5
            TabStroke.Color = Color3.new(1, 1, 1)
            TabStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            local TabGradient = Instance.new("UIGradient")
            TabGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
                ColorSequenceKeypoint.new(0.5, PURPLE),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
            })
            TabGradient.Parent = TabStroke
            GradientLoop(TabGradient)

            local Page = Instance.new("Frame")
            Page.Name = name.."Page"
            Page.Size = UDim2.new(1, 0, 1, 0)
            Page.Visible = false
            Page.BackgroundTransparency = 1
            Page.Parent = PageContainer

            local canTween = true
            TabBtn.MouseButton1Click:Connect(function()
                for _, p in pairs(PageContainer:GetChildren()) do
                    if p:IsA("Frame") then p.Visible = false end
                end
                Page.Visible = true
                if not canTween then return end
                canTween = false
                local neonInfo = TweenInfo.new(0.1, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
                local defaultInfo = TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
                TweenService:Create(TabBtn, neonInfo, {BackgroundTransparency = 0.5, BackgroundColor3 = PURPLE, TextTransparency = 0}):Play()
                TweenService:Create(TabStroke, neonInfo, {Thickness = 4, Color = PURPLE_LIGHT}):Play()
                task.wait(0.12)
                TweenService:Create(TabBtn, defaultInfo, {BackgroundTransparency = 1, BackgroundColor3 = Color3.fromRGB(20, 20, 20), TextTransparency = 0.2}):Play()
                TweenService:Create(TabStroke, defaultInfo, {Thickness = 2.5, Color = Color3.new(1, 1, 1)}):Play()
                task.wait(0.4)
                canTween = true
            end)

            return Page
        end

