local function FindPlayer(targetName)
    if type(targetName) ~= "string" then return nil end
    targetName = targetName:gsub("^%s+", ""):gsub("%s+$", "")
    if targetName == "" then return nil end
    local lower = targetName:lower()
    local list = Players:GetPlayers()
    for _, p in ipairs(list) do
        if p.Name:lower() == lower or p.DisplayName:lower() == lower then return p end
    end
    for _, p in ipairs(list) do
        if p.Name:lower():sub(1, #lower) == lower or p.DisplayName:lower():sub(1, #lower) == lower then return p end
    end
    for _, p in ipairs(list) do
        if p.Name:lower():find(lower, 1, true) or p.DisplayName:lower():find(lower, 1, true) then return p end
    end
    return nil
end

local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request

local function HttpCall(method, path, bodyTable)
    local url = FIREBASE_URL .. path
    local body = bodyTable and HttpService:JSONEncode(bodyTable) or nil

    local headers = {
        ["Content-Type"] = "application/json"
    }

    if httpRequest then
        local ok, res = pcall(httpRequest, {
            Url = url,
            Method = method,
            Headers = headers,
            Body = body,
        })
        if ok and res then
            if res.Success or (res.StatusCode and res.StatusCode >= 200 and res.StatusCode < 300) then
                local decoded
                if res.Body and res.Body ~= "" then
                    pcall(function() decoded = HttpService:JSONDecode(res.Body) end)
                end
                return true, decoded
            else
                warn("[HTTP ERROR] " .. method .. " " .. path .. " -> Status: " .. tostring(res.StatusCode) .. ", Body: " .. tostring(res.Body))
                return false, nil
            end
        end
        warn("[HTTP ERROR] Request failed: " .. tostring(res))
        return false, nil
    end

    if method == "GET" then
        local ok, res = pcall(function() return HttpService:GetAsync(url) end)
        if ok and res then
            local decoded
            pcall(function() decoded = HttpService:JSONDecode(res) end)
            return true, decoded
        end
        warn("[HTTP ERROR] GET failed: " .. tostring(res))
        return false, nil
    end
    if method == "POST" then
        local ok, res = pcall(function()
            return HttpService:PostAsync(url, body, Enum.HttpContentType.ApplicationJson)
        end)
        if ok and res then
            local decoded
            pcall(function() decoded = HttpService:JSONDecode(res) end)
            return true, decoded
        end
        warn("[HTTP ERROR] POST failed: " .. tostring(res))
    end
    if method == "PATCH" then
        local ok, res = pcall(function()
            return HttpService:RequestAsync({
                Url = url,
                Method = "PATCH",
                Headers = headers,
                Body = body,
            })
        end)
        if ok and res and res.Success then
            local decoded
            pcall(function() decoded = HttpService:JSONDecode(res.Body) end)
            return true, decoded
        end
        warn("[HTTP ERROR] PATCH failed: " .. tostring(res and res.Body or res))
    end
    return false, nil
end

