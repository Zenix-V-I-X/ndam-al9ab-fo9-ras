local function FindPlayer(targetName)
    if type(targetName) ~= "string" then return nil end
    targetName = targetName:gsub("^%s+", ""):gsub("%s+$", "")
    if targetName == "" then return nil end
    local lower = targetName:lower()
    local list = Players:GetPlayers()
    for _, p in ipairs(list) do
        if p.Name:lower() == lower or p.DisplayName:lower() == lower then
            return p
        end
    end
    for _, p in ipairs(list) do
        if p.Name:lower():sub(1, #lower) == lower or p.DisplayName:lower():sub(1, #lower) == lower then
            return p
        end
    end
    for _, p in ipairs(list) do
        if p.Name:lower():find(lower, 1, true) or p.DisplayName:lower():find(lower, 1, true) then
            return p
        end
    end
    return nil
end

